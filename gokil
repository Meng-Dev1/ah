    local function createEyeBillboard()
        if eyeBillboard then pcall(function() eyeBillboard:Destroy() end) end
        if eyePulseConn then eyePulseConn:Disconnect() eyePulseConn = nil end

        local head = character and character:FindFirstChild("Head")
        if not head then return end

