function Junkie.check_key(service, key)
    local resp = httpRequest({
        Method = "POST",
        Url = JUNKIE_BASE .. "/verifyOpen",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode({
            key = tostring(key or ""),
            service = service,
            identifier = tostring(Junkie.identifier)
        })
    })
    if not resp or resp.StatusCode ~= 200 then
        return {valid = false, error = "server_error"}
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(resp.Body) end)
    return ok and data or {valid = false, error = "decode_error"}
end

function Junkie.get_key_link(provider)
    local resp = httpRequest({
        Method = "POST",
        Url = JUNKIE_BASE .. "/getKeyOpen",
        Headers = {["Content-Type"] = "application/json"},
        Body = HttpService:JSONEncode({
            service = FREE_SERVICE,
            provider = tostring(provider or LINKVERTISE_PROVIDER),
            identifier = tostring(Junkie.identifier)
        })
    })
    if not resp then return nil, "ERROR" end
    if resp.StatusCode == 429 then return nil, "RATE_LIMITTED" end
    if resp.StatusCode ~= 200 then return nil, "ERROR" end
    return resp.Body, nil
end

