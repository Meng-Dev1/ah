    if LocalPlayer.Character then
        setupNoFallMonitor(LocalPlayer.Character)
    end
    
    local fovValue = 70
    local fovLocked = false
    local fovConnection = nil

    setFOV = function(value)
        if IsKiller() then return end

        local camera = workspace.CurrentCamera
        if camera then
            camera.FieldOfView = value
        end
    end

    lockFOV = function()
        if fovConnection then fovConnection:Disconnect() end
        
        fovConnection = workspace.CurrentCamera:GetPropertyChangedSignal("FieldOfView"):Connect(function()
            if fovLocked and not IsKiller() then
                setFOV(fovValue)
            end
        end)
    end

    SurvUtilitySection:AddSlider({
        Title = "FOV",
        Default = 70,
        Min = 40,
        Max = 140,
        Callback = function(value)
            fovValue = value
            if not IsKiller() then
                setFOV(value)
            end
        end
    })

    SurvUtilitySection:AddToggle({
        Title = "Lock FOV",
        Default = false,
        Callback = function(v)
            fovLocked = v
            if v then
                if not IsKiller() then
                    setFOV(fovValue)
                    lockFOV()
                end
            else
                if fovConnection then
                    fovConnection:Disconnect()
                    fovConnection = nil
                end
                if not IsKiller() then
                    setFOV(70)
                end
            end
        end
    })
    SurvUtilitySection:AddDivider()
    SelfHealToggle = SurvUtilitySection:AddToggle({
        Title = "Self Heal",
        Default = false,
        Premium = true,
        Keybind = true,
        Callback = function(v)
            SelfHealEnabled = v
            if v then
                blockHealAnim()
            else
                unblockHealAnim()
            end
            SendNotif("self heal: " .. (v and "enabled" or "disabled"))
        end
    })
    SurvUtilitySection:AddToggle({
        Title = "No Fall Damage",
        Default = false,
        Premium = true,
        Callback = function(state)
            NoFallEnabled = state
            SendNotif("no fall damage: " .. (state and "enabled" or "disabled"))

            if state and LocalPlayer.Character then
                LocalPlayer.Character:SetAttribute("speedboost", 1)
            end
        end
    })
    GodModeToggle = SurvUtilitySection:AddToggle({
        Title = "God Mode",
        Default = false,
        Keybind = true,
        Callback = function(state)
            GodModeEnabled = state
            SendNotif("godmode: ".. (state and "enabled" or "disabled"))
    
            if state then
                StartGodMode()
            else
                if GodModeThread then task.cancel(GodModeThread) end
            end
        end
    })
    _G.setGodMode = function(v)
        GodModeToggle:Set(not GodModeToggle.Value)
    end
end

