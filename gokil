        Callback = function(v)
            if v and LocalPlayer:GetAttribute("SelectedKiller") ~= "Butcher" then
                SendNotif("kamu bukan Butcher")
                return
            end
            ButcherSilentEnabled = v
            SendNotif("butcher silent aim: " .. (v and "enabled" or "disabled"))
        end
    })

    _G.setButcherSilent = function()
        ButcherToggle:Set(not ButcherToggle.Value)
    end

