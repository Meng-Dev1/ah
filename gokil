            local ok, btn = pcall(function()
                return LocalPlayer.PlayerGui["Survivor-mob"].Controls:FindFirstChild(name)
            end)
            return ok and btn or nil
        end

        local function savePositions()
            local data = {}
            for _, key in pairs(buttonKeys) do
                local btn = getButton(key)
                if btn then
                    data[key] = {
                        XScale = btn.Position.X.Scale, XOffset = btn.Position.X.Offset,
                        YScale = btn.Position.Y.Scale, YOffset = btn.Position.Y.Offset,
                    }
                end
            end
            pcall(function() writefile(posFile, HttpService:JSONEncode(data)) end)
        end

        local function loadAndApply()
            for _, key in pairs(buttonKeys) do
                local btn = getButton(key)
                if btn and not originalPositions[key] then
                    originalPositions[key] = {
                        XScale = btn.Position.X.Scale, XOffset = btn.Position.X.Offset,
                        YScale = btn.Position.Y.Scale, YOffset = btn.Position.Y.Offset,
                    }
                end
            end
            pcall(function()
                if isfile(posFile) then
                    local data = HttpService:JSONDecode(readfile(posFile))
                    for key, pos in pairs(data) do
                        local btn = getButton(key)
                        if btn then
                            btn.Position = UDim2.new(pos.XScale, pos.XOffset, pos.YScale, pos.YOffset)
                        end
                    end
                end
            end)
        end

        local function removeOverlays()
            for _, o in pairs(overlays) do pcall(function() o:Destroy() end) end
            overlays = {}
            for _, c in pairs(uisConnections) do pcall(function() c:Disconnect() end) end
            uisConnections = {}
        end

        local function addDragOverlay(btn)
            local UIS = game:GetService("UserInputService")
            local overlay = Instance.new("TextButton")
            overlay.Size = UDim2.new(1, 0, 1, 0)
            overlay.BackgroundTransparency = 1
            overlay.Text = ""
            overlay.ZIndex = btn.ZIndex + 10
            overlay.Parent = btn

            local dragging, dragStart, startPos, touchId = false, nil, nil, nil
            overlay.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; touchId = inp
                    dragStart = inp.Position; startPos = btn.Position
                end
            end)
            overlay.InputEnded:Connect(function(inp)
                if inp == touchId then
                    dragging = false; touchId = nil
                    savePositions()
                end
            end)
            local c = UIS.InputChanged:Connect(function(inp)
                if dragging and inp == touchId then
                    local d = inp.Position - dragStart
                    if d.Magnitude > 2 then
                        btn.Position = UDim2.new(
                            startPos.X.Scale, startPos.X.Offset + d.X,
                            startPos.Y.Scale, startPos.Y.Offset + d.Y)
                    end
                end
            end)
            table.insert(overlays, overlay)
            table.insert(uisConnections, c)
        end

        local function enableEditMode()
            removeOverlays()
            for _, key in pairs(buttonKeys) do
                local btn = getButton(key)
                if btn then addDragOverlay(btn) end
            end
        end

        local function disableEditMode()
            removeOverlays()
        end

        local function openEditor()
            if editorGui then editorGui:Destroy(); editorGui = nil; return end

            local sg = Instance.new("ScreenGui")
            sg.Name = "BtnPosEditor"
            sg.ResetOnSpawn = false
            sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
            sg.Parent = game:GetService("CoreGui")
            editorGui = sg

            local STEP = 5
            local selectedKey = buttonKeys[1]
            local rowRefs = {}
            local ITEM_H = 24
            local arrowSz = 32
            local arrowGap = 4
            local panelW = 190
            local panelH = 30 + #buttonKeys*ITEM_H + 10 + 22 + 8 + (arrowSz*3+arrowGap*2) + 12 + 28 + 10

            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(0, panelW, 0, panelH)
            frame.Position = UDim2.new(0, 20, 0, 80)
            frame.BackgroundColor3 = Color3.fromRGB(13, 13, 16)
            frame.BorderSizePixel = 0
            frame.Parent = sg
            Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)
            local fs = Instance.new("UIStroke", frame); fs.Color = Color3.fromRGB(45,45,55); fs.Thickness = 1

            local header = Instance.new("TextButton")
            header.Size = UDim2.new(1, 0, 0, 28)
            header.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
            header.BorderSizePixel = 0
            header.Text = "Button Position"
            header.TextColor3 = Color3.fromRGB(175, 175, 185)
            header.Font = Enum.Font.GothamMedium
            header.TextSize = 12
            header.AutoButtonColor = false
            header.Parent = frame
            Instance.new("UICorner", header).CornerRadius = UDim.new(0, 8)

            local closeBtn = Instance.new("TextButton", header)
            closeBtn.Size = UDim2.new(0, 24, 0, 24)
