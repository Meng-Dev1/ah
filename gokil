        elseif not isMoving and shiftHeld then
            VIM:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
            shiftHeld = false
        end
    end

    UserInputService.InputBegan:Connect(checkMovement)
    UserInputService.InputEnded:Connect(checkMovement)

    InvisibleSection:AddToggle({
        Title = "Auto Run [PC]",
        Default = false,
        Keybind = true,
        Callback = function(v)
            getgenv().AutoRunEnabled = v
            SendNotif("auto run: " .. (v and "enabled" or "disabled"))
            
