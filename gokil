    local function startKillerInfoLoop()
        if killerInfoLoopRunning then return end
        killerInfoLoopRunning = true

        task.spawn(function()
            while KSDetectorEnabled or PerksInfoEnabled do
                local gui = buildKillerInfoGui()
                local main = gui.MainFrame
                
                local currentKiller = nil
                for _, p in pairs(Players:GetPlayers()) do
                    if p.Team and p.Team.Name == "Killer" and p.Character then
                        currentKiller = p
                        break
                    end
                end

                if KSDetectorEnabled then
                    local status = main.KSValue
                    if currentKiller and currentKiller.Character then
