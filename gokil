do
    local autoPerfectEnabled = false
    local skillcheckMode = "Instant"
    local isScourgeActive = false
    local scourgeSession = nil
    local lastScourgeTime = 0
    local instantScourgeEnabled = false

    local Remotes = ReplicatedStorage:WaitForChild("Remotes")
    local KillerPerks = Remotes:WaitForChild("KillerPerks")
    local kingscourge = KillerPerks:WaitForChild("kingscourge")
    local KingScourgeStart = kingscourge:WaitForChild("KingScourgeStart")
    local KingScourgeHit = kingscourge:WaitForChild("KingScourgeHit")

    local skillGui, check, line, goal, trapGoal, trapPerfect
    local currentConnection = nil
    local visibleConn = nil
    local lastHitTime = 0

    local function cleanup()
        if currentConnection then
            currentConnection:Disconnect()
            currentConnection = nil
        end
        if visibleConn then
            visibleConn:Disconnect()
            visibleConn = nil
        end
    end

    local function updateReferences()
        if UserInputService.GamepadEnabled then
            skillGui = PlayerGui:FindFirstChild("SkillCheckPromptGui-con")
                or PlayerGui:FindFirstChild("SkillCheckPromptGui")
        else
            skillGui = PlayerGui:FindFirstChild("SkillCheckPromptGui")
                or PlayerGui:FindFirstChild("SkillCheckPromptGui-con")
        end

        if not skillGui then
            check, line, goal, trapGoal, trapPerfect = nil, nil, nil, nil, nil
            return false
        end

        check = skillGui:FindFirstChild("Check")
        line  = check and check:FindFirstChild("Line")
        goal  = check and check:FindFirstChild("Goal")
        trapGoal = check and check:FindFirstChild("TrapGoal")
        trapPerfect = check and check:FindFirstChild("TrapPerfect")

        return check and line and (goal or trapGoal or trapPerfect)
    end

    local function isTrapSkillcheck()
        return (trapGoal and trapGoal.Visible) or (trapPerfect and trapPerfect.Visible)
    end

    local function getActiveGoal()
        if isTrapSkillcheck() then
            if trapPerfect and trapPerfect.Visible then
                return trapPerfect
            end
            return trapGoal
        end
        return goal
    end

    local function hitSkillCheck()
        pcall(function()
            if UserInputService.GamepadEnabled then
                VIM:SendKeyEvent(true, Enum.KeyCode.ButtonL1, false, game)
                task.wait(0.04)
                VIM:SendKeyEvent(false, Enum.KeyCode.ButtonL1, false, game)
                return
            end

            if isMobile then
                local survivorMob = PlayerGui:FindFirstChild("Survivor-mob")
                if survivorMob then
                    local action = survivorMob:FindFirstChild("Controls") 
                        and survivorMob.Controls:FindFirstChild("action")
                    if action then
                        pcall(function() firesignal(action.MouseButton1Down) end)
                        pcall(function() firesignal(action.Activated) end)
                        pcall(function() firesignal(action.MouseButton1Click) end)
                        task.wait(0.03)
                        pcall(function() firesignal(action.MouseButton1Up) end)
                    end
                end
                return
            end

            if UserInputService.KeyboardEnabled then
                VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                task.wait(0.04)
                VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            end
        end)
    end

    local function stopTracking()
        if currentConnection then
            currentConnection:Disconnect()
            currentConnection = nil
        end
    end

    local function startTracking()
        if isScourgeActive or not autoPerfectEnabled then return end
        stopTracking()

        if not updateReferences() then return end
        if not check or not check.Visible then return end

        -- ========================
        -- TRAP MODE (Continuous)
        -- ========================
        if isTrapSkillcheck() then
            local lastTargetRot = nil
            local hasHitThisCycle = false

            currentConnection = RunService.Heartbeat:Connect(function()
                if not autoPerfectEnabled or isScourgeActive then
                    stopTracking()
                    return
                end

                if not check or not check.Parent or not check.Visible then
                    stopTracking()
                    return
                end

                -- Kalau sudah bukan trap lagi, stop
                if not isTrapSkillcheck() then
                    stopTracking()
                    return
                end

                local activeGoal = getActiveGoal()
                if not activeGoal then return end

                local targetRot = activeGoal.Rotation
                local rot = line.Rotation

                -- Deteksi cycle baru (goal rotation berubah)
                if lastTargetRot == nil or math.abs(targetRot - lastTargetRot) > 5 then
                    lastTargetRot = targetRot
                    hasHitThisCycle = false
                end

                -- Cooldown biar tidak spam hit di cycle yang sama
                if hasHitThisCycle then return end
                if tick() - lastHitTime < 0.35 then return end

                -- Zona perfect (legit)
                local perfectStart = targetRot + 102
                local perfectEnd   = targetRot + 116

                -- Normalize rotation (karena bisa lewat 360)
                local function inZone(r, start, finish)
                    -- sederhana karena game biasanya 0-360 range
                    return r >= start and r <= finish
                end

                if inZone(rot, perfectStart, perfectEnd) then
                    hasHitThisCycle = true
                    lastHitTime = tick()
                    hitSkillCheck()
                end
            end)
            return
        end

        -- ========================
        -- NORMAL SKILLCHECK
        -- ========================
        local startWait = tick()
        local activeGoal = getActiveGoal()
        while check.Visible and (not activeGoal or activeGoal.Rotation == 0) do
            task.wait(0.01)
            activeGoal = getActiveGoal()
            if tick() - startWait > 0.8 then break end
        end

        if not activeGoal then return end
        local targetRot = activeGoal.Rotation

        if skillcheckMode == "Instant" then
            line.Rotation = targetRot + 109
            
            local confirmed = false
            local waitStart = tick()
            while tick() - waitStart < 0.15 do
                if math.abs(line.Rotation - (targetRot + 109)) < 1 then
                    confirmed = true
                    break
                end
                task.wait(0.001)
            end
            
            if confirmed and check.Visible then
                hitSkillCheck()
            end
            
            stopTracking()
            return
        end

        local hitPerfect = (skillcheckMode == "Legit") or (math.random() > 0.35)
        local hitTarget = hitPerfect and (targetRot + 109) or (targetRot + 130)

        currentConnection = RunService.Heartbeat:Connect(function()
            if not autoPerfectEnabled or isScourgeActive then
                stopTracking()
                return
            end
            if not check or not check.Parent or not check.Visible then
                stopTracking()
                return
            end

            local rot = line.Rotation
            if rot > targetRot + 160 then
                stopTracking()
                return
            end

            if rot >= hitTarget then
                stopTracking()
                hitSkillCheck()
            end
        end)
    end

    local function initAutoPerfect()
        cleanup()
        stopTracking()

        if not updateReferences() then return end

        visibleConn = check:GetPropertyChangedSignal("Visible"):Connect(function()
            if not autoPerfectEnabled or isScourgeActive then return end
            if check.Visible then
                task.defer(startTracking)
            else
                stopTracking()
            end
        end)

        -- Kalau sudah visible saat init, langsung track
        if check.Visible then
            task.defer(startTracking)
        end
    end

    if getgenv().MengHub_KSConn then
        getgenv().MengHub_KSConn:Disconnect()
        getgenv().MengHub_KSConn = nil
    end

    getgenv().MengHub_KSConn = KingScourgeStart.OnClientEvent:Connect(function(p1, p2, p3)
        if not autoPerfectEnabled then return end
        if tick() - lastScourgeTime < 0.25 then return end

        lastScourgeTime = tick()
        isScourgeActive = true
        scourgeSession = p2
        local totalHits = p3 or 1

        task.spawn(function()
            if instantScourgeEnabled then
                for i = 1, totalHits do
                    if not isScourgeActive or not scourgeSession then break end

                    updateReferences()
                    if goal and line then
                        line.Rotation = goal.Rotation + 109
                    end

                    task.wait(0.028)

                    pcall(function()
                        KingScourgeHit:FireServer(scourgeSession, "success")
                    end)

                    hitSkillCheck()

                    task.wait(0.042 + math.random(1, 7) / 100)
                end

                task.wait(0.2)
                isScourgeActive = false
                scourgeSession = nil
                return
            end

            local elapsed = 0
            repeat
                task.wait(0.05)
                elapsed += 0.05
            until (check and check.Visible) or elapsed >= 3

            for i = 1, totalHits do
                if not isScourgeActive or not scourgeSession then break end

                updateReferences()
                if goal and line and check and check.Visible then
                    local targetRot = goal.Rotation

                    local earlyOffset
                    if i <= 3 then earlyOffset = 0
                    elseif i <= 7 then earlyOffset = -3
                    elseif i <= 12 then earlyOffset = -5
                    else earlyOffset = -7 end

                    local hitPerfect = (skillcheckMode == "Legit") or (math.random() > 0.85)
                    local hitTarget = hitPerfect
                        and (targetRot + 109 + earlyOffset)
                        or  (targetRot + 130 + earlyOffset)

                    local pollInterval
                    if i <= 3 then pollInterval = 0.01
                    elseif i <= 7 then pollInterval = 0.007
                    else pollInterval = 0.004 end

                    local waited = 0
                    while waited < 1.5 do
                        if not isScourgeActive or not check.Visible then break end
                        if line.Rotation >= hitTarget then
                            hitSkillCheck()
                            break
                        end
                        task.wait(pollInterval)
                        waited += pollInterval
                    end

                    if i < totalHits then
                        local waitNext = 0
                        repeat
                            task.wait(0.05)
                            waitNext += 0.05
                        until (check and check.Visible) or waitNext >= 2
                    end
                end
            end

            task.wait(0.2)
            isScourgeActive = false
            scourgeSession = nil
        end)
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(2)
        if autoPerfectEnabled then
            initAutoPerfect()
        end
    end)

    PlayerGui.DescendantAdded:Connect(function(desc)
        if not autoPerfectEnabled then return end
        if desc.Name == "Check" and desc.Parent and 
           (desc.Parent.Name == "SkillCheckPromptGui" or desc.Parent.Name == "SkillCheckPromptGui-con") then
            task.wait(0.05)
            initAutoPerfect()
        end
    end)

    AutoPerfect = Tabs.Survivor:AddSection("Auto Skillcheck Perfect")
    AutoPerfect:AddDropdown({
        Title = "Skillcheck Mode",
        Options = {"Instant", "Legit", "Random"},
        Default = "Instant",
        Callback = function(opts)
            skillcheckMode = opts
        end
    })
    AutoPerfect:AddToggle({
        Title = "Instant King Scourge's",
        Content = "This feature will make the King Scourge's minigame instantly complete",
        Default = false,
        Callback = function(v)
            instantScourgeEnabled = v
            SendNotif("instant king scourge's: " .. (v and "enabled" or "disabled"))
        end
    })
    AutoPerfect:AddToggle({
        Title = "Enable Auto Skillcheck Perfect",
        Default = false,
        Keybind = true,
        Callback = function(state)
            autoPerfectEnabled = state
            SendNotif("auto skillcheck perfect: " .. (state and "enabled" or "disabled"))

            if state then
                initAutoPerfect()
            else
                cleanup()
                stopTracking()
                isScourgeActive = false
                scourgeSession = nil
            end
        end
    })
end

