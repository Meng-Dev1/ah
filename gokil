            end
        end)
    end

    local function StartAutoDropPallet()
        if DropPalletThread then return end

        refreshPalletCache()

        DropPalletThread = RunService.Heartbeat:Connect(function()
            if not AutoDropPallet then return end

            if tick() - lastRefresh > 3 then
                lastRefresh = tick()
                refreshPalletCache()
            end

            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local isKnocked = char:GetAttribute("Knocked") == true
            local isCarried = char:GetAttribute("IsCarried") == true

            if SafetyDropPallet and (isKnocked or isCarried) then return end
            if isKnocked and not isCarried then return end

            for palletModel, _ in pairs(palletGroups) do
                if not palletModel.Parent then continue end

                if palletModel:FindFirstChild("PalletPointSlide") then continue end

                local activePoints = {}
                for _, child in ipairs(palletModel:GetChildren()) do
                    if child.Name == "PalletPoint" and child:IsA("BasePart") then
                        table.insert(activePoints, child)
                    end
                end

                if #activePoints ~= 2 then continue end

                local dist1 = (activePoints[1].Position - hrp.Position).Magnitude
                local dist2 = (activePoints[2].Position - hrp.Position).Magnitude

                local myPoint, opponentPoint
                if dist1 < dist2 then
                    myPoint = activePoints[1]
                    opponentPoint = activePoints[2]
                else
                    myPoint = activePoints[2]
                    opponentPoint = activePoints[1]
                end

                local distToPlayerPoint = (myPoint.Position - hrp.Position).Magnitude
                if distToPlayerPoint > 6 then continue end

                local killerOnOpponentPoint = false
                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl.Team and pl.Team.Name == "Killer" and pl.Character then
                        local kHRP = pl.Character:FindFirstChild("HumanoidRootPart")
                        if kHRP then
                            local distKillerToOpponent = (opponentPoint.Position - kHRP.Position).Magnitude
                            if distKillerToOpponent <= 7 then
                                killerOnOpponentPoint = true
                                break
                            end
                        end
                    end
                end

                if killerOnOpponentPoint then
                    if isCarried and not SafetyDropPallet then
                        pcall(function()
                            PalletDropEvent:FireServer(myPoint)
                        end)
                    else
                        triggerPalletInput()
                    end
                    
                    refreshPalletCache()
                    break
                end
            end
        end)
    end

    local function StopAutoDropPallet()
        if DropPalletThread then
            DropPalletThread:Disconnect()
            DropPalletThread = nil
        end
        palletGroups = {}
    end

    GlobalSection:AddToggle({
        Title = "Auto Drop Pallet",
