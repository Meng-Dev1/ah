        if not updateRemote then
            updateRemote = game:GetService("ReplicatedStorage").Remotes.Game:FindFirstChild("UpdateCharacterLook")
        end
        if not updateRemote then return end
        pcall(function()
            updateRemote:FireServer(voidNeck, voidCFrame, voidCFrame, voidCFrame, voidCFrame)
        end)
    end

    enableInvis = function()
        invisEnabled = true
        setupCharacter()
        if not character or not root then return end

        originalTransparencies = {}
        originalCanCollide = {}

        for _, v in ipairs(character:GetDescendants()) do
            if v:IsA("BasePart") then
                originalTransparencies[v] = v.Transparency
                originalCanCollide[v] = v.CanCollide

                if v.Name == "HRP_Clone" or v.Name == "HumanoidRootPart" or v.Name == "Hurtbox" then
                    v.Transparency = 1
                    v.CanCollide = false
                else
                    v.Transparency = 0.5

                    if v.Name == "HumanoidRootPart" or v.Name == "UpperTorso" or v.Name == "LowerTorso" or v.Name == "Torso" then
                        v.CanCollide = true
                    else
                        v.CanCollide = false
                    end
                end
            elseif v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
                v.Visible = false
            elseif v:IsA("Decal") then
                originalTransparencies[v] = v.Transparency
                v.Transparency = 1
            elseif v:IsA("SurfaceGui") then
                v.Enabled = false
            end
        end

        createHighlight()
        createEyeBillboard()
        sendVoidUpdate()

        if updateLoopConn then
            pcall(function() task.cancel(updateLoopConn) end)
            updateLoopConn = nil
        end

        updateLoopConn = task.spawn(function()
            while invisEnabled and character and character.Parent do
                sendVoidUpdate()
                task.wait()
            end
        end)
    end

    disableInvis = function()
        invisEnabled = false

        if updateLoopConn then
            pcall(function() task.cancel(updateLoopConn) end)
            updateLoopConn = nil
        end

        destroyEyeBillboard()

        if character and character.Parent then
            for _, v in ipairs(character:GetDescendants()) do
                if v:IsA("BasePart") then
                    if v.Name == "HumanoidRootPart" or v.Name == "HRP_Clone" or v.Name == "Hurtbox" then
                        v.Transparency = 1
                    elseif originalTransparencies[v] ~= nil then
                        v.Transparency = originalTransparencies[v]
                    else
                        v.Transparency = 0
                    end

                    if originalCanCollide[v] ~= nil then
                        v.CanCollide = originalCanCollide[v]
                    else
                        v.CanCollide = true
                    end
                elseif v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
                    v.Visible = true
                elseif v:IsA("Decal") then
                    if originalTransparencies[v] ~= nil then
                        v.Transparency = originalTransparencies[v]
                    else
                        v.Transparency = 0
                    end
                elseif v:IsA("SurfaceGui") then
                    v.Enabled = true
                end
            end
        end

        if highlight then
            pcall(function() highlight:Destroy() end)
            highlight = nil
        end

        originalTransparencies = {}
        originalCanCollide = {}
    end

    LocalPlayer.CharacterAdded:Connect(function()
        if invisEnabled then
