local CheckStates  = {}
local ActiveStates = {}
local LabelGuis    = {}
local PanelGui     = nil

local function saveMobConfig()
    local data = {
        checkStates    = CheckStates,
        activeStates   = ActiveStates,
        labelPositions = {},
        panelPosition  = nil,
    }

    for id, sg in pairs(LabelGuis) do
        local frame = sg:FindFirstChildOfClass("Frame")
        if frame then
            data.labelPositions[id] = {
                XScale  = frame.Position.X.Scale,
                XOffset = frame.Position.X.Offset,
                YScale  = frame.Position.Y.Scale,
                YOffset = frame.Position.Y.Offset,
            }
        end
    end

    if PanelGui then
        local frame = PanelGui:FindFirstChildOfClass("Frame")
        if frame then
            data.panelPosition = {
                XScale  = frame.Position.X.Scale,
                XOffset = frame.Position.X.Offset,
                YScale  = frame.Position.Y.Scale,
                YOffset = frame.Position.Y.Offset,
            }
        end
    end

    pcall(function()
        if not isfolder("MengHub_VD") then makefolder("MengHub_VD") end
        local ok, json = pcall(function()
            return game:GetService("HttpService"):JSONEncode(data)
        end)
        if ok then writefile(MOB_CONFIG_FILE, json) end
    end)
    SendNotif("Mob Panel settings saved!")
end

local function loadMobConfig()
    local data = nil
    pcall(function()
        if isfile and isfile(MOB_CONFIG_FILE) then
            local ok, decoded = pcall(function()
                return game:GetService("HttpService"):JSONDecode(readfile(MOB_CONFIG_FILE))
            end)
            if ok then data = decoded end
        end
    end)
    return data
end

local function resetMobConfig()
    pcall(function()
        if isfile and isfile(MOB_CONFIG_FILE) then
            delfile(MOB_CONFIG_FILE)
        end
    end)
    for _, feat in ipairs(MobFeatures) do
        if ActiveStates[feat.id] then pcall(feat.off) end
        if LabelGuis[feat.id] then
            LabelGuis[feat.id]:Destroy()
            LabelGuis[feat.id] = nil
        end
    end
    CheckStates  = {}
    ActiveStates = {}
    SendNotif("Mob Panel settings reset!")
end

local function createLabelGui(feat, savedPos)
    if feat.premium and not IsProviderPremium then
        SendNotif("unlock this with premium!")
        return
    end
    if LabelGuis[feat.id] then return LabelGuis[feat.id] end

    if feat.getState then
        ActiveStates[feat.id] = feat.getState()
    else
        ActiveStates[feat.id] = ActiveStates[feat.id] or false
    end

    local sg = Instance.new("ScreenGui")
    sg.Name = "MobLabel_" .. feat.id
    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = CoreGui

    LabelGuis[feat.id] = sg

    local textSize = TextService:GetTextSize(feat.label, 14, Enum.Font.Code, Vector2.new(1000, 50))
    local boxW = textSize.X + 38

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, boxW, 0, 32)
    frame.BorderSizePixel = 0
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    frame.Parent = sg
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 5)

    if savedPos then
        frame.Position = UDim2.new(savedPos.XScale, savedPos.XOffset, savedPos.YScale, savedPos.YOffset)
    else
        frame.Position = UDim2.new(0.5, -(boxW/2), 0, 80)
    end

    local stroke = Instance.new("UIStroke", frame)
    stroke.Thickness = 1.8
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = Color3.fromRGB(65, 65, 65)

    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Text = feat.label
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Code
    btn.TextSize = 14
    btn.AutoButtonColor = false
    btn.Active = true

    local function updateVisual()
        local on = ActiveStates[feat.id]
        if on then
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            stroke.Color = Color3.fromRGB(160, 100, 255) 
        else
            btn.TextColor3 = Color3.fromRGB(240, 240, 240)
            stroke.Color = Color3.fromRGB(65, 65, 65)
        end
    end

    task.spawn(function()
        while LabelGuis[feat.id] do
            if feat.getState then
                local realState = feat.getState()
                if ActiveStates[feat.id] ~= realState then
                    ActiveStates[feat.id] = realState
                    updateVisual()
                end
            end
            task.wait(0.3)
        end
    end)

    local dragging = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    local hasDragged = false

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if input.UserInputState == Enum.UserInputState.Begin then
                if dragging then return end
                dragging = true
                hasDragged = false
                dragInput = input
                dragStart = input.Position
                startPos = frame.Position

                local connection
                connection = input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                        dragInput = nil
                        if connection then connection:Disconnect() end
                    end
                end)
            end
        end
    end)

    local dragConn
    dragConn = UserInputService.InputChanged:Connect(function(input)
        if dragging and dragInput then
            local isTouch = (input == dragInput)
            local isMouse = (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
            if isTouch or isMouse then
                local delta = input.Position - dragStart
                if delta.Magnitude > 5 then
                    hasDragged = true
                end
                frame.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            end
        end
    end)

    frame.Destroying:Connect(function()
        if dragConn then
            dragConn:Disconnect()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        if hasDragged then return end

        local real = (feat.getState and feat.getState()) or ActiveStates[feat.id] or false
        local newState = not real

        ActiveStates[feat.id] = newState
        updateVisual()

        if newState then
            pcall(feat.on)
        else
            pcall(feat.off)
        end
    end)

    updateVisual()
    return sg
end

local function applyMobConfig()
    local data = loadMobConfig()
    if not data then return end

    if data.checkStates then
        for id, v in pairs(data.checkStates) do CheckStates[id] = v end
    end
    if data.activeStates then
        for id, v in pairs(data.activeStates) do ActiveStates[id] = v end
    end

    for _, feat in ipairs(MobFeatures) do
        if ActiveStates[feat.id] then pcall(feat.on) end
    end

    task.wait(1)

    for _, feat in ipairs(MobFeatures) do
        if CheckStates[feat.id] then
            local savedPos = data.labelPositions and data.labelPositions[feat.id]
            createLabelGui(feat, savedPos)
        end
    end
end

task.spawn(applyMobConfig)

