GetConfigList = function()
    local list = {}
    if isfolder(ConfigFolder) then
        for _, v in pairs(listfiles(ConfigFolder)) do
            if v:sub(-5) == ".json" then
                local name = v:match("([^/\\]+)$"):gsub(".json", "")
                table.insert(list, name)
            end
        end
    end
    return list
end
