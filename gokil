local function MakeDraggable(frame, dragObject, getLocked)
    dragObject = dragObject or frame
    local dragging = false
    local dragStart = nil
    local startPos = nil

    dragObject.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or
           input.UserInputType == Enum.UserInputType.Touch then
            if getLocked and getLocked() then return end
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            ContextActionService:BindActionAtPriority(
                "MobPanelDragLock",
                function(_, _, _) return Enum.ContextActionResult.Sink end,
                false,
                9999,
                Enum.UserInputType.Touch
            )

            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    ContextActionService:UnbindAction("MobPanelDragLock")
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if getLocked and getLocked() then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or
           input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end
