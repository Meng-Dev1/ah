        end
    end)

    InvisToggle, InvisColorPicker = InvisibleSection:AddToggle({
        Title = "Invisible",
        Default = false,
        Keybind = true,
        Premium = true,
        KeybindDefault = "X",
        Colorpicker = true,                              
        ColorDefault = invisColor,                       
        ColorCallback = function(color)                  
            invisColor = color
            if highlight and highlight.Parent then       
                highlight.FillColor = color
            end
        end,
        Callback = function(state)
            SendNotif("invisibility: " .. (state and "enabled" or "disabled"))
            if state then
                enableInvis()
            else
                disableInvis()
            end
        end
    })

    if InvisColorPicker then
        InvisColorPicker:Set(invisColor)
    end

    _G.setInvisibility = function(v)
        InvisToggle:Set(not InvisToggle.Value)
    end

