            return false
        end
        return true
    end

    local function GetPumpkinList()
        local pumpkins = {}

        for model in pairs(blacklistedPumpkins) do
            if typeof(model) ~= "Instance" or not model.Parent then
                blacklistedPumpkins[model] = nil
            end
        end

        local map = workspace:FindFirstChild("Map")
        local pumpkinFolder = map and map:FindFirstChild("Pumpkins")
        if not pumpkinFolder then return pumpkins end

        for _, item in ipairs(pumpkinFolder:GetChildren()) do
            if (item:IsA("Model") or item:IsA("BasePart")) and not IsBlacklisted(item) then
                local targetPart
                if item:IsA("BasePart") then
                    targetPart = item
                else
                    targetPart = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
                end

                if targetPart and targetPart.Parent then
                    table.insert(pumpkins, { Model = item, Part = targetPart })
                end
            end
        end

        return pumpkins
    end

