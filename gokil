    local function scanZombies()
        for _, conn in pairs(zombieConnections) do
            pcall(function() conn:Disconnect() end)
        end
        zombieConnections = {}
        for obj in pairs(zombieESP) do removeZombieESP(obj) end

        if not espZombie or not espEnabled then return end

        local function checkAndAddZombie(obj)
            if not obj or not obj:IsA("Model") then return end
            if not obj.Name:lower():find("^scp") then return end

            local hasHumanoid = obj:FindFirstChildOfClass("Humanoid")
            local hasBody = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")

            if hasHumanoid or hasBody then
                if not zombieESP[obj] then
                    zombieESP[obj] = buildESP(obj, C_ZOMBIE, obj.Name)
                end
            end
        end

        for _, child in pairs(workspace:GetChildren()) do
            checkAndAddZombie(child)
        end

        local mapFolder = workspace:FindFirstChild("Map")
        if mapFolder then
            for _, desc in pairs(mapFolder:GetDescendants()) do
                checkAndAddZombie(desc)
            end
        end

        table.insert(zombieConnections, workspace.ChildAdded:Connect(function(child)
            task.wait(0.1)
            checkAndAddZombie(child)
        end))

        if mapFolder then
            table.insert(zombieConnections, mapFolder.DescendantAdded:Connect(function(desc)
                task.wait(0.2) 
                checkAndAddZombie(desc)
            end))
        end

        table.insert(zombieConnections, workspace.DescendantRemoving:Connect(function(desc)
            if zombieESP[desc] then
                removeZombieESP(desc)
            end
        end))
    end

    local function applyBotESP(rig)
        if not rig or not rig:IsA("Model") then return end
        if not rig:IsDescendantOf(workspace) then return end
        if Players:GetPlayerFromCharacter(rig) then return end
        if not CollectionService:HasTag(rig, "SurvivorBot") then return end

        -- rig player asli jangan pernah dianggap bot
        if typeof(rig:GetAttribute("BotNetId")) ~= "number"
            and CollectionService:HasTag(rig, "Survivor") then
            return
        end

        local owner = Players:FindFirstChild(rig.Name)
        local realName = nil
        if owner then
            if owner.Character == rig then return end
            realName = owner.Name
        end

        local hum = rig:FindFirstChildOfClass("Humanoid")
        if not hum then
            removePlayerESP(rig)
            return
        end

        -- mati beneran = health 0 DAN gak dalam keadaan knocked/hooked
        if hum.Health <= 0
            and not (rig:GetAttribute("Knocked") or rig:GetAttribute("IsHooked")) then
            removePlayerESP(rig)
            return
        end

        local old = playerESP[rig]
        if old and not old.isBot then return end   -- jangan nimpa ESP player asli
        if old then removePlayerESP(rig) end

        local botName = realName or rig.Name
        local d = buildESP(rig, C_SUR, botName)
        d.isMurder = false
        d.isKiller = false
        d.isBot   = true
        d.baseName = botName
        d.owner    = owner
        playerESP[rig] = d
    end

    local function applyPlayerESP(pl)
        local char = pl.Character
        if not char or not char:IsDescendantOf(workspace) or char.Name == "Lobby" then return end

        local playerName = pl.Name
        local isMurder = pl.Team and pl.Team.Name == "Killer" or false
        
        local existing = playerESP[char]

        if existing and (existing.isBot or existing.isMurder ~= isMurder) then
            removePlayerESP(char)
            existing = nil
        end

        if isMurder then
            if not espMurder then removePlayerESP(char) return end
            if not existing then
                local d = buildESP(char, C_KIL, playerName)
                d.isMurder = true
                d.isKiller = true
                d.isBot = false
                d.owner = pl
                playerESP[char] = d
                
                local stunRing, stunSpinThread = buildStunRingUI(char)
                d.stunRing = stunRing
                d.stunSpinThread = stunSpinThread

                local function showRing(duration)
                    if not d.stunRing or not ShowStunRing then return end
                    d.stunRing.Enabled = true
                    if d._stunTimer then task.cancel(d._stunTimer) end
                    d._stunTimer = task.delay(duration, function()
                        if d.stunRing then d.stunRing.Enabled = false end
                    end)
                end

                local stunConn = char:GetAttributeChangedSignal("IsStunned"):Connect(function()
                    if char:GetAttribute("IsStunned") == true then showRing(2.2) end
                end)

                local immobileConn = char:GetAttributeChangedSignal("Immobile"):Connect(function()
                    if char:GetAttribute("Immobile") == true then showRing(2.2) end
                end)

                if not d.extraConns then d.extraConns = {} end
                table.insert(d.extraConns, stunConn)
                table.insert(d.extraConns, immobileConn)
            end
        else
            if not espSurvivor then removePlayerESP(char) return end
            if not existing then
                local d = buildESP(char, C_SUR, playerName)
                d.isMurder = false
                d.isKiller = false
                d.isBot = false
                d.owner = pl
                playerESP[char] = d
            end
        end
    end

