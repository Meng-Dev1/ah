do
    local AimbotEnabled = false
    local FOV = isMobile and 180 or 120
    local KillerAimRange = 30
    local AimbotThread = nil
    local ShowFOVCircle = false
    local FOVCircleGui = nil

    local Aiming = false
    local MobileButtonHeld = false

    local function RenderFOVCircle()
        if FOVCircleGui then
            FOVCircleGui:Destroy()
            FOVCircleGui = nil
        end
        if not ShowFOVCircle or not AimbotEnabled then return end

        local cam = workspace.CurrentCamera
        local vp = cam.ViewportSize
        
        local guiService = game:GetService("GuiService")
        local topInset = guiService:GetGuiInset().Y

        local cx = vp.X / 2
        local cy = (vp.Y / 2) - (topInset * 0.6)

        local fovRad = math.rad(FOV / 2)
        local radius = math.tan(fovRad) * (vp.Y / 2)
        radius = math.clamp(radius, 10, math.min(vp.X, vp.Y) / 2)

        local segments = 64
        local gui = Instance.new("ScreenGui")
        gui.Name = "FOVCircleGui"
        gui.DisplayOrder = 999997
        gui.ResetOnSpawn = false
        gui.Parent = CoreGui
        FOVCircleGui = gui

        for i = 1, segments do
            local angle1 = (i - 1) / segments * math.pi * 2
            local angle2 = i / segments * math.pi * 2

            local x1 = cx + math.cos(angle1) * radius
            local y1 = cy + math.sin(angle1) * radius
            local x2 = cx + math.cos(angle2) * radius
            local y2 = cy + math.sin(angle2) * radius

            local dx = x2 - x1
            local dy = y2 - y1
            local len = math.sqrt(dx*dx + dy*dy)
            local midX = (x1 + x2) / 2
            local midY = (y1 + y2) / 2
            local rot = math.deg(math.atan2(dy, dx))

            local seg = Instance.new("Frame")
            seg.Size = UDim2.new(0, len + 1, 0, 2)
            seg.Position = UDim2.new(0, midX - (len / 2), 0, midY - 1)
            seg.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            seg.BorderSizePixel = 0
            seg.Rotation = rot
            seg.Parent = gui
        end
    end

    local function isTargetInFOV(targetHrp)
        if not targetHrp then return false end
        local camera = workspace.CurrentCamera
        local camLook = camera.CFrame.LookVector
        local direction = (targetHrp.Position - camera.CFrame.Position).Unit
        local dot = camLook:Dot(direction)
        return dot > math.cos(math.rad(FOV / 2))
    end

    local function GetClosestTarget()
        local hrp = GetRoot()
        if not hrp then return nil end

        local myTeam = LocalPlayer.Team and LocalPlayer.Team.Name or ""
        local closestTarget = nil
        local shortestDist = math.huge

        if myTeam == "Killer" then
            for _, player in pairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local char = player.Character
                if not char then continue end

                local playerTeam = player.Team and player.Team.Name or ""
                if playerTeam ~= "Survivors" then continue end

                local targetHrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")

                if not targetHrp or not hum or hum.Health <= 0 then continue end

                if char:GetAttribute("Knocked") or
                   char:GetAttribute("IsCarried") or
                   char:GetAttribute("IsHooked") then continue end

                local dist = (targetHrp.Position - hrp.Position).Magnitude
                if dist > KillerAimRange then continue end
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = targetHrp
                end
            end
        else
            for _, player in pairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                local char = player.Character
                if not char then continue end

                local targetHrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local playerTeam = player.Team and player.Team.Name or ""

                if targetHrp and hum and hum.Health > 0 and playerTeam == "Killer" then
                    if isTargetInFOV(targetHrp) then
                        local dist = (targetHrp.Position - hrp.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestTarget = targetHrp
                        end
                    end
                end
            end
        end

        return closestTarget
    end

    local function AimAt(targetHrp)
        if not targetHrp then return end

        local camera = workspace.CurrentCamera
        local targetChar = targetHrp.Parent
        local head = targetChar:FindFirstChild("Head")

        local aimPosition = targetHrp.Position
        local rightOffset = camera.CFrame.RightVector * 0.8
        local finalAimPos = aimPosition + rightOffset

        local currentCFrame = camera.CFrame
        local targetCFrame = CFrame.lookAt(currentCFrame.Position, finalAimPos)

        camera.CFrame = currentCFrame:Lerp(targetCFrame, 0.55)
    end

    local function StartAimbot()
        if AimbotThread then return end

        AimbotThread = task.spawn(function()
            while AimbotEnabled do
                if IsPlayerInLobby() then 
                    task.wait(0.5) 
                    continue 
                end

                local isHolding = Aiming or MobileButtonHeld
                
                if isHolding then
                    local target = GetClosestTarget()
                    if target then 
                        AimAt(target) 
                    end
                end

                task.wait()
            end
        end)
    end

    local function StopAimbot()
        if AimbotThread then
            if typeof(AimbotThread) == "RBXScriptConnection" then
                AimbotThread:Disconnect()
            else
                pcall(task.cancel, AimbotThread)
            end
            AimbotThread = nil
        end
    end

    local function SetupPCInput()
        UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            local myTeam = LocalPlayer.Team and LocalPlayer.Team.Name or ""

            if UserInputService.GamepadEnabled then
                if myTeam == "Killer" then
                    if input.KeyCode == Enum.KeyCode.ButtonR2 then
                        Aiming = true
                    end
                else
                    if input.KeyCode == Enum.KeyCode.ButtonL2 then
                        Aiming = true
                    end
                end
            else
                if myTeam == "Killer" then
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Aiming = true
                    end
                else
                    if input.UserInputType == Enum.UserInputType.MouseButton2 then
                        Aiming = true
                    end
                end
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            local myTeam = LocalPlayer.Team and LocalPlayer.Team.Name or ""

            if UserInputService.GamepadEnabled then
                if myTeam == "Killer" then
                    if input.KeyCode == Enum.KeyCode.ButtonR2 then
                        Aiming = false
                    end
                else
                    if input.KeyCode == Enum.KeyCode.ButtonL2 then
                        Aiming = false
                    end
                end
            else
                if myTeam == "Killer" then
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Aiming = false
                    end
                else
                    if input.UserInputType == Enum.UserInputType.MouseButton2 then
                        Aiming = false
                    end
                end
            end
        end)
    end

    local function SetupMobileInput()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
        if not playerGui then return end

        local activeConnections = {}

        local function ClearMobileConnections()
            for _, conn in ipairs(activeConnections) do
                if conn then conn:Disconnect() end
            end
            table.clear(activeConnections)
        end

        local function BindTouch(button)
            if not button then return end
            table.insert(activeConnections, button.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    MobileButtonHeld = true
                end
            end))
            table.insert(activeConnections, button.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    MobileButtonHeld = false
                end
            end))
        end

        local function ProcessGui(gui)
            if not gui then return end
            local nameLower = gui.Name:lower()

            if gui.Name == "Survivor-mob" then
                local controls = gui:WaitForChild("Controls", 5)
                if controls then
                    local guiMob = controls:WaitForChild("Gui-mob", 5)
                    if guiMob then
                        BindTouch(guiMob)
                    end
                end
            elseif nameLower:find("mob") and not nameLower:find("survivor") then
                local controls = gui:WaitForChild("Controls", 5)
                if controls then
                    local attackBtn = controls:WaitForChild("attack", 5)
                    if attackBtn then
                        BindTouch(attackBtn)
                    end
                end
            end
        end

        for _, child in ipairs(playerGui:GetChildren()) do
            task.spawn(ProcessGui, child)
        end

        playerGui.ChildAdded:Connect(function(child)
            MobileButtonHeld = false
            task.spawn(ProcessGui, child)
        end)
    end

    local inputSetup = false
    local function SetupInput()
        if inputSetup then return end
        inputSetup = true
        if isMobile then
            SetupMobileInput()
        else
            SetupPCInput()
        end
    end

    LocalPlayer:GetPropertyChangedSignal("Team"):Connect(function()
        if not AimbotEnabled then return end
        inputSetup = false
        Aiming = false
        MobileButtonHeld = false
        task.wait(0.5)
        SetupInput()
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        if not AimbotEnabled then return end
        inputSetup = false
        Aiming = false
        MobileButtonHeld = false
        task.wait(1)
