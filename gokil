    local function getNearestKillerDistance()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then return nil end

        local nearestDist = math.huge

        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer and pl.Team and pl.Team.Name == "Killer" then
                local kChar = pl.Character
                local kRoot = kChar and kChar:FindFirstChild("HumanoidRootPart")
                if kRoot then
                    local dist = (kRoot.Position - root.Position).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                    end
                end
            end
        end

        return nearestDist < math.huge and nearestDist or nil
