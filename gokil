    local function getSmoothedVelocity(player, part, character)
        local char = character or (player and player.Character)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or not part then return Vector3.zero end

        local moveDir = hum.MoveDirection
        local walkSpeed = math.max(hum.WalkSpeed or 16, 12)
        local physVel = part.AssemblyLinearVelocity
        local physXZ = Vector3.new(physVel.X, 0, physVel.Z)

        local key = player or char
        local histVel = Vector3.zero
        local history = velocityHistory[key]
        if history and #history > 0 then
            local sum = Vector3.zero
            for i = 1, #history do
                local v = history[i]
                sum = sum + Vector3.new(v.X, 0, v.Z)
            end
            histVel = sum / #history
        end

        local inputMag = moveDir.Magnitude
        local physMag = physXZ.Magnitude

        -- beneran diem
        if inputMag < 0.08 and physMag < 0.9 then
            if history then table.clear(history) end
            return Vector3.zero
        end

        local vel
        if inputMag > 0.08 then
            -- arah input paling dipercaya (strafing kiri/kanan)
            local inputVel = moveDir.Unit * walkSpeed
            vel = inputVel * 0.88 + physXZ * 0.08 + histVel * 0.04
        else
            vel = physXZ * 0.72 + histVel * 0.28
        end

        vel = Vector3.new(vel.X, 0, vel.Z)
        if vel.Magnitude < 0.7 then
            return Vector3.zero
        end
        return vel
    end

    local function predictPosition(targetPart, originPos, speed, gravScale, targetPlayer, targetCharacter)
        local char = targetCharacter or (targetPlayer and targetPlayer.Character)
        local aimPart = (char and (
            char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
        )) or targetPart

        -- pose: jongkok / repair = aim lebih rendah
        local yOffset = 0.1
        if char then
            local crouching = char:GetAttribute("Crouching") == true
            local repairing = false
            local check = char:FindFirstChild("CheckInterractable")
            if check and check:GetAttribute("isRepairing") then
                repairing = true
            end
            if char:GetAttribute("isRepairing") or char:GetAttribute("Repairing") then
                repairing = true
            end
            if crouching or repairing then
                yOffset = -1.35
            end
        end

        local targetPos = aimPart.Position + Vector3.new(0, yOffset, 0)
        local targetVel = getSmoothedVelocity(targetPlayer, aimPart, targetCharacter)
        local speedXZ = targetVel.Magnitude

        local g = workspace.Gravity * gravScale
        local toTarget = targetPos - originPos
        local horizontal = Vector3.new(toTarget.X, 0, toTarget.Z).Magnitude

        -- flight time iterasi
        local flightTime = math.clamp(horizontal / speed, 0.05, 4.2)
        for _ = 1, 14 do
            local predicted = targetPos + targetVel * flightTime
            local drop = 0.5 * g * flightTime * flightTime
            predicted = predicted + Vector3.new(0, drop, 0)

            local dir = predicted - originPos
            local newHoriz = Vector3.new(dir.X, 0, dir.Z).Magnitude
            local newTime = math.clamp(newHoriz / speed, 0.05, 4.2)

            if math.abs(newTime - flightTime) < 0.0005 then
                flightTime = newTime
                break
            end
            flightTime = flightTime * 0.3 + newTime * 0.7
        end

        -- DIEM = no lead
        if speedXZ < 0.8 then
            local drop = 0.5 * g * flightTime * flightTime
            return targetPos + Vector3.new(0, drop, 0)
        end

        -- ===== LEAD LENGKET (deket → jauh) =====
        -- dasar: flightTime * faktor jarak * faktor speed
        local distFactor
        if horizontal < 40 then
            distFactor = 1.08
        elseif horizontal < 70 then
            distFactor = 1.16
        elseif horizontal < 100 then
            distFactor = 1.22
        elseif horizontal < 140 then
            distFactor = 1.28
        elseif horizontal < 180 then
            distFactor = 1.34
        elseif horizontal < 230 then
            distFactor = 1.40
        elseif horizontal < 280 then
            distFactor = 1.46
        else
            distFactor = 1.52
        end

        -- speed factor: makin kencang makin maju
        local speedFactor = 1.0
        if speedXZ > 16 then
            speedFactor = 1.10
        elseif speedXZ > 13 then
            speedFactor = 1.07
        elseif speedXZ > 10 then
            speedFactor = 1.04
        elseif speedXZ > 7 then
            speedFactor = 1.02
        end

        local leadTime = flightTime * distFactor * speedFactor
        local leadPos = targetPos + targetVel * leadTime
        local drop = 0.5 * g * flightTime * flightTime

        return leadPos + Vector3.new(0, drop, 0)
    end

    local function getAutoGravScale(dist)
        if dist < 40 then return 0.5
