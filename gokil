    local function handleMapObject(child)
        if not espEnabled then return end
        
        local rootModel = child
        if not child:IsA("Model") and not child:IsA("Folder") and child.Parent then
            if child.Parent:IsA("Model") or child.Parent:IsA("Folder") then
                rootModel = child.Parent
            end
        end

        if scannedObjects[rootModel] then return end
        local nameLower = rootModel.Name:lower()
        
        -- Generator
        if nameLower:match("generator") then
            if espGenerator then
                local function isGenDone(obj)
                    return obj:GetAttribute("Completed") == true
                    or (obj:GetAttribute("RepairProgress") or 0) >= 100
                end

                if isGenDone(rootModel) then
                    if mapESP[rootModel] then removeMapESP(rootModel) end
                    scannedObjects[rootModel] = true
                    return
                end

                if scannedObjects[rootModel] then return end

                scannedObjects[rootModel] = true
                mapESP[rootModel] = buildESP(rootModel, C_GEN, "Generator")

                local function checkGenStatus()
                    if not rootModel or not rootModel.Parent then
                        if mapESP[rootModel] then removeMapESP(rootModel) end
                        return
                    end

                    local d = mapESP[rootModel]
                    if isGenDone(rootModel) then
                        if d then
                            if d.highlight then d.highlight:Destroy() end
                            if d.bill then d.bill:Destroy() end
                            if d.progBill then d.progBill:Destroy() end
                            if d.box then d.box:Destroy() end
                            mapESP[rootModel] = nil
                        end
                        if genConnections[rootModel] then
                            for _, conn in pairs(genConnections[rootModel]) do
                                pcall(function() conn:Disconnect() end)
                            end
                            genConnections[rootModel] = nil
                        end
                    else
                        if d and d.progBar and d.progTxt then
                            local progress = rootModel:GetAttribute("RepairProgress") or 0
                            local clampedProgress = math.clamp(progress / 100, 0, 1)
                            d.progBar.Size = UDim2.new(clampedProgress, 0, 1, 0)
                            d.progTxt.Text = math.floor(progress) .. "%"

                            local colorRed = Color3.fromRGB(220, 80, 80)    
                            local colorYellow = Color3.fromRGB(220, 220, 80) 
                            local colorGreen = Color3.fromRGB(80, 220, 100)  

                            if clampedProgress < 0.5 then
                                d.progBar.BackgroundColor3 = colorRed:Lerp(colorYellow, clampedProgress * 2)
                            else
                                d.progBar.BackgroundColor3 = colorYellow:Lerp(colorGreen, (clampedProgress - 0.5) * 2)
                            end
                        end
                    end
                end

                if genConnections[rootModel] then
                    for _, conn in pairs(genConnections[rootModel]) do
                        pcall(function() conn:Disconnect() end)
                    end
                end

                genConnections[rootModel] = {
                    rootModel:GetAttributeChangedSignal("Completed"):Connect(checkGenStatus),
                    rootModel:GetAttributeChangedSignal("RepairProgress"):Connect(checkGenStatus),
                }

                checkGenStatus()
            end
            return
        end

        -- Pallet
        if nameLower:find("newpallet", 1, true) then
            if rootModel:IsA("Model") or rootModel:IsA("Folder") then
                if espPallet and not mapESP[rootModel] then
                    scannedObjects[rootModel] = true
                    mapESP[rootModel] = buildESP(rootModel, C_PAL, "Pallet")
                end
            end
            return
        end

        -- Vault / Window Bottom
        if child.Name == "VaultTrigger" or nameLower == "window" then
            if espVault then
                local windowModel = child:IsA("Model") and child or child.Parent
                local bottomPart = windowModel and windowModel:FindFirstChild("Bottom")
                
                if bottomPart and bottomPart:IsA("BasePart") and not mapESP[windowModel] then
                    scannedObjects[windowModel] = true
                    local adornData = buildVaultBoxESP(bottomPart)
                    if adornData then
                        mapESP[windowModel] = {
                            highlight = adornData.highlight,
                            box = adornData.box,
                            isVault = true,
                            baseName = "Vault"
                        }
                    end
                end
            end
            return
        end

        -- Pumpkin
        if nameLower:match("pumpkin") then
            if espPumpkin and not mapESP[rootModel] then
                scannedObjects[rootModel] = true
                mapESP[rootModel] = buildESP(rootModel, C_PUMPKIN, "Pumpkin")
            end
            return
        end

        -- Bear Trap
        if nameLower:match("beartrap") then
            if espBearTrap and not mapESP[rootModel] then
                scannedObjects[rootModel] = true
                mapESP[rootModel] = buildESP(rootModel, C_BEARTRAP, "Bear Trap")
            end
            return
        end

        -- Gate
        if child.Name == "ExitLever" or child.Name == "RightGate" or child.Name == "LeftGate" then
            if espGate and not mapESP[child] and not scannedObjects[child] then
                scannedObjects[child] = true
                local displayTitle = child.Name == "ExitLever" and "Gate Lever" or "Gate Door"
                mapESP[child] = buildESP(child, C_GATE, displayTitle)
            end
            return
        elseif (child:IsA("Folder") or child:IsA("Model")) and (nameLower:match("gate") or child.Name:match("^%d+$")) then
            if espGate then
                for _, subChild in pairs(child:GetChildren()) do
                    if subChild.Name == "ExitLever" or subChild.Name == "RightGate" or subChild.Name == "LeftGate" then
                        if not mapESP[subChild] and not scannedObjects[subChild] then
                            scannedObjects[subChild] = true
                            local displayTitle = subChild.Name == "ExitLever" and "Gate Lever" or "Gate Door"
                            mapESP[subChild] = buildESP(subChild, C_GATE, displayTitle)
                        end
                    end
                end
            end
            return
        end

        -- Hook
        if nameLower:match("hook") then
            if nameLower:match("meat") then return end
            
            if espHook then
                local targetObj = rootModel:FindFirstChild("Model") or rootModel
                if not mapESP[targetObj] and not scannedObjects[targetObj] then
                    scannedObjects[targetObj] = true
                    mapESP[targetObj] = buildESP(targetObj, C_HOOK, "Hook")
                end
            end
        end
    end

    local function scanMapOnce()
        if not espEnabled then return end
        
        mapScanned = false 
        mapScanned = true
        
        clearMapConnections()
        clearAllMapESP()

        scanZombies()

        for _, folder in pairs(getMapFolders()) do
            local function scanLevel(parent, depth)
                if depth > 5 then return end
                for _, child in pairs(parent:GetChildren()) do
                    handleMapObject(child)

                    if child:IsA("Folder") or child:IsA("Model") then
                        scanLevel(child, depth + 1)
                    end
                end
            end
            
            scanLevel(folder, 1)
            
            table.insert(mapScanConnections, folder.DescendantAdded:Connect(function(desc)
                task.wait()
                handleMapObject(desc)
            end))
            table.insert(mapScanConnections, folder.DescendantRemoving:Connect(function(desc)
                removeMapESP(desc)
                if desc.Parent and mapESP[desc.Parent] then removeMapESP(desc.Parent) end
            end))
        end
    end

    local function startEspLoop()
        if _G.MengHubThread then
            pcall(task.cancel, _G.MengHubThread)
            _G.MengHubThread = nil
        end

        _G.MengHubThread = task.spawn(function()
            while espEnabled do
                local hrp_local = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                local cam = workspace.CurrentCamera
                local needLabel = ShowName or ShowDistance or ShowItemImage or ShowPlatform

                for _, pl in ipairs(Players:GetPlayers()) do
                    if pl ~= LocalPlayer and pl.Character and pl.Character:IsDescendantOf(workspace) then
                        local char = pl.Character
                        if char.Name ~= "Lobby" then
                            applyPlayerESP(pl)
                        end
                    end
                end

                if espSurvivor then
                    for _, rig in ipairs(CollectionService:GetTagged("SurvivorBot")) do
                        if rig:IsDescendantOf(workspace) then
                            local realPl = Players:GetPlayerFromCharacter(rig) or Players:FindFirstChild(rig.Name)
                            if not realPl then
                                if not playerESP[rig] then
                                    applyBotESP(rig)
                                end
                            else
                                applyPlayerESP(realPl)
                            end
                        end
                    end
                end

                for char, data in pairs(playerESP) do
                    if char and char:IsDescendantOf(workspace) then
                        local pl = Players:GetPlayerFromCharacter(char)
                        
                        if data.isBot then
                            local owner = pl or Players:FindFirstChild(char.Name)
                            if owner and (owner.Character == char or owner.Character == nil) then
                                data.owner = owner
                                data.baseName = owner.Name
                                data.isBot = false
                                if data.nameLbl and data.nameLbl.Text ~= owner.Name then
                                    data.nameLbl.Text = owner.Name
                                end
                                pl = owner
                            end
                        end

                        if data then
                            local hrp_target = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")

                            local hl = char:FindFirstChild("MengHubESP_Highlight")
                            if not hl then
                                hl = Instance.new("Highlight")
                                hl.Name = "MengHubESP_Highlight"
                                hl.Adornee = char
                                hl.Parent = char
                            end

                            hl.Enabled = ShowHL
                            hl.FillTransparency = 0.75
                            hl.OutlineTransparency = 0.05
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

                            if data.isKiller then
                                hl.FillColor = C_KIL
                                hl.OutlineColor = C_KIL
                            else
                                hl.FillColor = C_SUR
                                hl.OutlineColor = C_SUR
                            end
                            data.highlight = hl

                            if needLabel and hrp_target and hrp_local then
                                local dist = math.floor((hrp_local.Position - hrp_target.Position).Magnitude)
                                local scaleFactor = cam and math.clamp(1400 / dist, 0.7, 1.2) or 1

                                if data.bill then
                                    data.bill.Size = UDim2.new(0, math.floor(200 * scaleFactor), 0, math.floor(24 * scaleFactor))
                                end

                                local iconSize = math.clamp(math.floor(14 * scaleFactor), 10, 14)

                                if data.platformIcon then
                                    if ShowPlatform and pl then
                                        if not data.platformAsset then
                                            local platform = pl:GetAttribute("platform") or ""
                                            if platform == "PC" then
                                                data.platformAsset = "rbxassetid://12684119225"
                                            elseif platform == "Console" then
                                                data.platformAsset = "rbxassetid://11894535915"
                                            elseif platform == "Mobile" then
                                                data.platformAsset = "rbxassetid://13021320268"
                                            end
                                        end

                                        if data.platformAsset then
                                            data.platformIcon.Image = data.platformAsset
                                            data.platformIcon.Size = UDim2.new(0, iconSize, 0, iconSize)
                                            data.platformIcon.Visible = true
                                        else
                                            data.platformIcon.Visible = false
                                        end
                                    else
                                        data.platformIcon.Visible = false
                                    end
                                end

                                if ShowName then
                                    local displayName
                                    if _G.ProtectNameEnabled then
                                        displayName = "MENGHUB #1"
                                    elseif pl then
                                        displayName = pl.Name
                                    else
                                        displayName = data.baseName or char.Name
                                    end

                                    data.nameLbl.Text = displayName
                                    data.nameLbl.Visible = true
                                else
                                    data.nameLbl.Visible = false
                                end

                                if ShowDistance then
                                    data.distLbl.Text = "[" .. dist .. "m]"
                                    data.distLbl.Visible = true
                                else
                                    data.distLbl.Visible = false
                                end

                                if ShowItemImage and pl then
                                    local _, iAsset = getPlayerItem(pl)
                                    if iAsset then
                                        data.itemIcon.Image = iAsset
                                        data.itemIcon.Size = UDim2.new(0, iconSize, 0, iconSize)
                                        data.itemIcon.Visible = true
                                    else
                                        data.itemIcon.Visible = false
                                    end
                                else
                                    data.itemIcon.Visible = false
                                end

                                if data.bgFrame then
                                    data.bgFrame.Visible = data.nameLbl.Visible 
                                        or data.distLbl.Visible 
                                        or data.itemIcon.Visible 
                                        or (data.platformIcon and data.platformIcon.Visible)
                                end
                            else
                                if data.bgFrame then data.bgFrame.Visible = false end
                            end
                        end
                    else
                        removePlayerESP(char)
                    end
                end

                for obj, data in pairs(zombieESP) do
                    if obj and obj.Parent then
                        if data.highlight then 
                            data.highlight.Enabled = ShowHL 
                            data.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        end
                    else
                        removeZombieESP(obj)
                    end
                end

                task.wait(0.1)
            end
        end)
    end

    local function cleanupPlayer(pl)
        if perPlayerConnections[pl] then
            for _, c in pairs(perPlayerConnections[pl]) do
                pcall(function() c:Disconnect() end)
            end
            perPlayerConnections[pl] = nil
        end
        if pl.Character then removePlayerESP(pl.Character) end
    end

    local function watchPlayer(pl)
        if pl == LocalPlayer then return end

        if perPlayerConnections[pl] then
            for _, c in pairs(perPlayerConnections[pl]) do
                pcall(function() c:Disconnect() end)
            end
        end

        perPlayerConnections[pl] = {
            pl.CharacterAdded:Connect(function(char)
                task.wait(1)
                if espEnabled then applyPlayerESP(pl) end
            end),
            pl.CharacterRemoving:Connect(function(char)
                removePlayerESP(char)
            end),
            pl:GetPropertyChangedSignal("Team"):Connect(function()
                task.wait(0.5)
                if not espEnabled then return end
                if not pl.Character or pl.Character.Name == "Lobby" then return end
                local char = pl.Character
                removePlayerESP(char)
                applyPlayerESP(pl)
            end),
        }

        if pl.Character and espEnabled then
            applyPlayerESP(pl)
        end
    end

    local function setupPlayerEvents()
        for pl in pairs(perPlayerConnections) do
            cleanupPlayer(pl)
        end
        perPlayerConnections = {}

        for _, conn in pairs(globalConnections) do
            pcall(function() conn:Disconnect() end)
        end
        globalConnections = {}

        for _, pl in pairs(Players:GetPlayers()) do
            watchPlayer(pl)
        end

        table.insert(globalConnections, Players.PlayerAdded:Connect(function(pl)
            watchPlayer(pl)
        end))

        table.insert(globalConnections, Players.PlayerRemoving:Connect(function(pl)
            cleanupPlayer(pl)
