    local function findAttackButton()
        local playerGui = LocalPlayer.PlayerGui
        
        for _, v in ipairs(playerGui:GetChildren()) do
            if v.Name:find("-mob") or v.Name:lower():find("controls") then
                local controls = v:FindFirstChild("Controls") or v
                local attack = controls:FindFirstChild("attack")
                
                if attack and (attack:IsA("TextButton") or attack:IsA("ImageButton")) then
                    return attack
                end
            end
        end
        
        for _, desc in ipairs(playerGui:GetDescendants()) do
            if desc.Name:lower() == "attack" and 
            (desc:IsA("TextButton") or desc:IsA("ImageButton")) then
                return desc
            end
        end
        
        return nil
    end

    local function hasLineOfSight(originPos, torsoPos, targetCharacter)
        local direction = torsoPos - originPos
        local distance = direction.Magnitude
        if distance < 0.1 then return true end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local excludeList = {}
        local localChar = LocalPlayer.Character
        if localChar then
            table.insert(excludeList, localChar)
        end
        if targetCharacter and targetCharacter ~= localChar then
            table.insert(excludeList, targetCharacter)
        end

        rayParams.FilterDescendantsInstances = excludeList

        local result = workspace:Raycast(originPos, direction.Unit * distance, rayParams)
        return result == nil
    end

    local function getNearestEnemy(root)
        local nearest = nil
        local nearestDist = math.huge
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= LocalPlayer and pl.Character then
                local tr = pl.Character:FindFirstChild("HumanoidRootPart")
                local hum = pl.Character:FindFirstChildOfClass("Humanoid")
                if tr and hum and hum.Health > 0 then
                    local char = pl.Character
                    local isKnocked = char:GetAttribute("Knocked") == true
                        or char:GetAttribute("IsKnocked") == true
                    local isHooked = char:GetAttribute("IsHooked") == true
                        or char:GetAttribute("Hooked") == true

                    if not isKnocked and not isHooked then
                        local dist = (tr.Position - root.Position).Magnitude
                        if dist < nearestDist and hasLineOfSight(root.Position, tr.Position, char) then
                            nearestDist = dist
                            nearest = { hrp = tr, dist = dist }
                        end
                    end
                end
            end
        end
        return nearest
    end

