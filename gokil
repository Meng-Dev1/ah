            stepLbl.BackgroundTransparency = 1; stepLbl.Text = "step"
            stepLbl.TextColor3 = Color3.fromRGB(85,85,95)
            stepLbl.Font = Enum.Font.Gotham; stepLbl.TextSize = 10

            for i, s in ipairs({5,10,20}) do
                local sb = Instance.new("TextButton", frame)
