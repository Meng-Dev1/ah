local function updateSpectatorList()
    if not SpectatorGui then return end
    local mainFrame = SpectatorGui:FindFirstChild("MainFrame")
    local minimizedFrame = SpectatorGui:FindFirstChild("MinimizedFrame")
    if not mainFrame or not minimizedFrame then return end
    
    local listFrame = mainFrame:FindFirstChild("ListFrame")
    if not listFrame then return end

    for _, c in ipairs(listFrame:GetChildren()) do
        c:Destroy()
    end

    local Players = game:GetService("Players")
    local spectators = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Players.LocalPlayer then
            local isSpec = false
            if p.Team then
                local tname = p.Team.Name:lower()
                if tname:find("spectator") or tname:find("spec") then
                    isSpec = true
                end
            end
            if not p.Character then isSpec = true end
            if isSpec then
                table.insert(spectators, p)
            end
        end
    end

    local countLabel = minimizedFrame:FindFirstChild("CountLabel")
    if countLabel then
        countLabel.Text = tostring(#spectators)
    end

    local itemH = 26
    local listH = #spectators == 0 and 28 or #spectators * itemH + 6
    listFrame.Size = UDim2.new(1, 0, 0, listH)
    mainFrame.Size = UDim2.new(0, 190, 0, 42 + listH)

    if #spectators == 0 then
        local empty = Instance.new("TextLabel", listFrame)
        empty.Size = UDim2.new(1, -16, 0, 28)
        empty.Position = UDim2.new(0, 8, 0, 0)
        empty.BackgroundTransparency = 1
        empty.Text = "No spectators"
        empty.TextColor3 = Color3.fromRGB(140, 140, 150)
        empty.Font = Enum.Font.Code
        empty.TextSize = 12.5
        empty.TextXAlignment = Enum.TextXAlignment.Left
    else
        for i, p in ipairs(spectators) do
            local row = Instance.new("Frame", listFrame)
            row.Size = UDim2.new(1, -12, 0, itemH)
            row.Position = UDim2.new(0, 6, 0, (i-1) * itemH + 3)
            row.BackgroundTransparency = 1
            row.BorderSizePixel = 0

            local thumb = Instance.new("ImageLabel", row)
