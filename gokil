                btn.MouseButton1Click:Connect(function()
                    local b = getButton(selectedKey)
                    if not b then return end
                    b.Position = UDim2.new(
                        b.Position.X.Scale, b.Position.X.Offset + dx*STEP,
                        b.Position.Y.Scale, b.Position.Y.Offset + dy*STEP)
                    savePositions()
                end)
            end

            makeArrow("↑",1,0,0,-1)
            makeArrow("↝",0,1,-1,0)
            makeArrow("→",2,1,1,0)
            makeArrow("↓",1,2,0,1)

            local resetY = arrowY + arrowSz*3 + arrowGap*2 + 10
            local resetBtn = Instance.new("TextButton", frame)
            resetBtn.Size = UDim2.new(1,-12,0,26); resetBtn.Position = UDim2.new(0,6,0,resetY)
            resetBtn.BackgroundColor3 = Color3.fromRGB(18,18,22); resetBtn.BorderSizePixel = 0
            resetBtn.Text = "Reset semua posisi"; resetBtn.TextColor3 = Color3.fromRGB(190,75,75)
            resetBtn.Font = Enum.Font.GothamMedium; resetBtn.TextSize = 11; resetBtn.AutoButtonColor = false
            Instance.new("UICorner", resetBtn).CornerRadius = UDim.new(0,5)
            local rs = Instance.new("UIStroke", resetBtn); rs.Color = Color3.fromRGB(65,30,30); rs.Thickness = 1
            resetBtn.MouseButton1Click:Connect(function()
                for key, pos in pairs(originalPositions) do
                    local btn = getButton(key)
                    if btn then
                        btn.Position = UDim2.new(pos.XScale, pos.XOffset, pos.YScale, pos.YOffset)
                    end
                end
                pcall(function() if isfile(posFile) then delfile(posFile) end end)
                SendNotif("Semua posisi direset ke default")
            end)
        end

        LocalPlayer.PlayerGui.ChildAdded:Connect(function(child)
            if child.Name == "Survivor-mob" then
                task.wait(0.8)
                loadAndApply()
                if editMode then enableEditMode() end
            end
        end)

        if LocalPlayer.PlayerGui:FindFirstChild("Survivor-mob") then
            task.wait(0.5)
            loadAndApply()
        end

        MobileControlSection = Tabs.Settings:AddSection("Custom Button Position")

        MobileControlSection:AddToggle({
            Title = "Edit Mode (drag button)",
            Default = false,
            Callback = function(v)
                editMode = v
                if v then
