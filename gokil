                        if hasKS ~= nil then
                            status.Text = "Active"
                            status.TextColor3 = Color3.fromRGB(70, 255, 170)
                            if lastKSStatus ~= "Active" and SendNotif then
                                SendNotif("Killer is using King Scourge!")
