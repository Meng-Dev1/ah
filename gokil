                btn.Size = UDim2.new(0,arrowSz,0,arrowSz)
                btn.Position = UDim2.new(0, startX+gx*(arrowSz+arrowGap), 0, arrowY+gy*(arrowSz+arrowGap))
                btn.BackgroundColor3 = Color3.fromRGB(20,20,26); btn.BorderSizePixel = 0
                btn.Text = label; btn.TextColor3 = Color3.fromRGB(160,160,172)
                btn.Font = Enum.Font.GothamBold; btn.TextSize = 15; btn.AutoButtonColor = false
                Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)
