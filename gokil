            MakeDraggable(frame, header)

            local function refreshRows()
                for k, r in pairs(rowRefs) do
                    local on = k == selectedKey
                    r.dot.BackgroundColor3 = on and Color3.fromRGB(100,160,255) or Color3.fromRGB(50,50,62)
