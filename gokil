            ApplyFakeAvaAppearance()
        end
    end)
    
    local FakeKorlessSystem = {
        IsActive = false,
        RespawnEvent = nil
    }

    local function BuildCustomRig(character)
        if not character or not FakeKorlessSystem.IsActive then return end

        local head = character:WaitForChild("Head", 5)
        local rightLeg = character:WaitForChild("Right Leg", 5)

        if not (head and rightLeg) then return end

        pcall(function()
            head.Transparency = 1
            local face = head:FindFirstChild("face")
            if face then
                face.Transparency = 1
            end

            rightLeg.Transparency = 1
            
            if character:FindFirstChild("FakeKorbloxMesh") then return end

            local korbloxMesh = Instance.new("MeshPart")
            korbloxMesh.Name = "FakeKorbloxMesh"
            korbloxMesh.Size = Vector3.new(0.85, 0.85, 0.85)
            korbloxMesh.CanCollide = false
            korbloxMesh.MeshId = "rbxassetid://902942096"
            korbloxMesh.TextureID = "rbxassetid://902843398"
            korbloxMesh.CFrame = rightLeg.CFrame * CFrame.new(0, 0.7, 0)

            local weld = Instance.new("WeldConstraint")
            weld.Part0 = rightLeg
            weld.Part1 = korbloxMesh
            weld.Parent = korbloxMesh

            korbloxMesh.Parent = character
        end)
    end

    local function RestoreOriginalRig(character)
        if not character then return end

        pcall(function()
            local head = character:FindFirstChild("Head")
            if head then
                head.Transparency = 0
                local face = head:FindFirstChild("face")
                if face then
                    face.Transparency = 0 
                end
            end

            local rightLeg = character:FindFirstChild("Right Leg")
            if rightLeg then
                rightLeg.Transparency = 0
            end

            local fakeMesh = character:FindFirstChild("FakeKorbloxMesh")
            if fakeMesh then
                fakeMesh:Destroy() 
            end
        end)
    end

    local function SetFakeKorlessState(state)
        FakeKorlessSystem.IsActive = state

        if state then
            if LocalPlayer.Character then
                task.spawn(BuildCustomRig, LocalPlayer.Character)
            end

            if FakeKorlessSystem.RespawnEvent then
                FakeKorlessSystem.RespawnEvent:Disconnect()
            end
            
            FakeKorlessSystem.RespawnEvent = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
                task.wait(0.5)
                BuildCustomRig(newCharacter)
            end)
        else
            if FakeKorlessSystem.RespawnEvent then
                FakeKorlessSystem.RespawnEvent:Disconnect()
                FakeKorlessSystem.RespawnEvent = nil
            end

            if LocalPlayer.Character then
                RestoreOriginalRig(LocalPlayer.Character)
            end
        end
    end

    local FakeKorlessSection = Tabs.Emote:AddSection("Fake Korless")
    FakeKorlessSection:AddButton({
