    local function doShoot()
        if not silentAimEnabled or not isAiming then return end
        local targetDirection, gunObject, originPos, targetPos = getTargetPosition()
        if not (targetDirection and gunObject and targetPos and originPos) then return end
        
        local Char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        if Char and silentAimSafety then
            if Char:GetAttribute("Knocked") or Char:GetAttribute("IsHooked") or Char:GetAttribute("IsCarried") then
                return
            end

            local interactObj = Char:FindFirstChild("CheckInterractable")
            if interactObj then
                if interactObj:GetAttribute("isVaulting") then return end
                if interactObj:GetAttribute("isRepairing") then return end
                if interactObj:GetAttribute("isUnhooking") then return end
                if interactObj:GetAttribute("isHealing") then return end
                if interactObj:GetAttribute("isSliding") then return end
            end
        end

        local freshDirection = (targetPos - originPos).Unit
        pcall(function()
            ToFEvent:FireServer(gunObject, freshDirection)
        end)
        lastShootTime = tick()
    end

    local function startConnection()
        if Connection then return end
        Connection = RunService.Heartbeat:Connect(function()
            if isAiming and silentAimEnabled then
                local targetDirection, gunObject, originPos, targetPos, realTargetPos = getTargetPosition()
                
                if targetDirection and gunObject then
                    pcall(function()
                        local char = LocalPlayer.Character
                        local hrp = char and char:FindFirstChild("HumanoidRootPart")
                        if hrp and not char:GetAttribute("IsCarried") then
                            hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z))
                        end
                    end)

                    if laserEnabled and originPos and realTargetPos then
                        updateLaser(originPos, realTargetPos)
                    elseif LaserBeam then
                        LaserBeam.Transparency = 1
                    end
                else
                    if LaserBeam then LaserBeam.Transparency = 1 end
                end
            else
                if LaserBeam then LaserBeam.Transparency = 1 end
            end
        end)
    end

    local function stopConnection()
        if Connection then
            Connection:Disconnect()
            Connection = nil
        end
        clearLaser()
    end

