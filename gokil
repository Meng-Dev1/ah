do
    local HiddenSkillAimbot = false
    local FOV_RADIUS = 240
    local MAX_DISTANCE = 90
    local LOCK_DURATION = 1.5       
    local isLocking = false
    local hasLockedThisSkill = false
    local m2StartTime = 0
    local lockedTarget = nil 

    local function getClosestInFOV()
        local closest = nil
        local shortest = math.huge
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local camPos = Camera.CFrame.Position

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer 
                and player.Character 
                and player.Character:FindFirstChild("HumanoidRootPart")
                and player.Character:FindFirstChild("Humanoid")
                and player.Character.Humanoid.Health > 0
                and not player.Character:GetAttribute("Knocked")
                and not player.Character:GetAttribute("IsHooked")
            then
                local hrp = player.Character.HumanoidRootPart
                local worldDist = (hrp.Position - camPos).Magnitude

                if worldDist > MAX_DISTANCE then
                    continue
                end

                local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)

                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if dist < FOV_RADIUS and dist < shortest then
                        closest = hrp
                        shortest = dist
                    end
                end
            end
        end
        return closest
    end

    local function isM2Playing()
        local char = LocalPlayer.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        local animator = hum:FindFirstChildOfClass("Animator")
        if not animator then return false end

        for _, track in pairs(animator:GetPlayingAnimationTracks()) do
            if track.Animation and track.Animation.AnimationId == "rbxassetid://98163597193511" then
                return true
            end
        end
        return false
    end

    local function isHidden()
        return LocalPlayer.Team and LocalPlayer.Team.Name == "Killer" 
            and LocalPlayer:GetAttribute("SelectedKiller") == "Hidden"
    end

    RunService.RenderStepped:Connect(function()
        if not HiddenSkillAimbot or not isHidden() then
            isLocking = false
            hasLockedThisSkill = false
            lockedTarget = nil
            return
        end

        local playing = isM2Playing()

        -- Reset flag kalau animasi sudah benar-benar selesai
        if not playing then
            isLocking = false
            hasLockedThisSkill = false
            lockedTarget = nil
            return
        end

        -- Hanya boleh lock SEKALI per cast skill
        if playing and not isLocking and not hasLockedThisSkill then
            isLocking = true
            hasLockedThisSkill = true
            m2StartTime = tick()
            lockedTarget = getClosestInFOV()

            if not lockedTarget then
                task.spawn(function()
                    for i = 1, 8 do
                        task.wait(0.016)
                        if not isLocking then return end
                        lockedTarget = getClosestInFOV()
                        if lockedTarget then break end
                    end
                end)
            end
        end

        if isLocking then
            local elapsed = tick() - m2StartTime

            -- Paksa lepas setelah durasi
            if elapsed > LOCK_DURATION then
                isLocking = false
                lockedTarget = nil
                return
            end

            if lockedTarget and lockedTarget.Parent then
                local hum = lockedTarget.Parent:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not lockedTarget.Parent:GetAttribute("Knocked") then
                    local cam = workspace.CurrentCamera
                    local camPos = cam.CFrame.Position
                    local aimPos = lockedTarget.Position + Vector3.new(0, 1.4, 0)

                    cam.CFrame = CFrame.new(camPos, aimPos)

                    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local lookAt = Vector3.new(lockedTarget.Position.X, root.Position.Y, lockedTarget.Position.Z)
                        root.CFrame = CFrame.new(root.Position, lookAt)
                    end
                else
                    isLocking = false
                    lockedTarget = nil
                end
            end
        end
    end)

    HiddenAimbotSection = Tabs.Aimbot:AddSection("Hidden Skill Aimbot")
    HiddenAimbotToggle = HiddenAimbotSection:AddToggle({
        Title = "Enable Skill Aimbot Hidden",
        Default = false,
        Keybind = true,
        Premium = true,
        Callback = function(v)
            HiddenSkillAimbot = v
            isLocking = false
            hasLockedThisSkill = false
            lockedTarget = nil

            if v then
                if isHidden() then
                    SendNotif("hidden aimbot: enabled")
                else
                    SendNotif("hidden aimbot: enabled (waiting for Hidden)")
                end
            else
                SendNotif("hidden aimbot: disabled")
            end
        end
    })

    _G.setHiddenAimbot = function()
        HiddenAimbotToggle:Set(not HiddenAimbotToggle.Value)
    end
end

do
    FlashlightSection = Tabs.Aimbot:AddSection("Flashlight Aimbot")
    
    local FlashlightAimEnabled = false
    local FlashlightThread = nil
    local FlashlightAiming = false
    local FlashlightMobileHeld = false

    local function GetFlashlightTarget()
        local hrp = GetRoot()
        if not hrp then return nil end

        local closestTarget = nil
        local shortestDist = math.huge
        local FOV_FLASHLIGHT = 40

        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            local char = player.Character
            if not char then continue end

            local playerTeam = player.Team and player.Team.Name or ""
            if playerTeam ~= "Killer" then continue end

            local targetHead = char:FindFirstChild("Head")
            local targetHrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")

            if not targetHrp or not hum or hum.Health <= 0 then continue end

            local camera = workspace.CurrentCamera
            local camLook = camera.CFrame.LookVector
            local direction = (targetHrp.Position - camera.CFrame.Position).Unit
            local dot = camLook:Dot(direction)
            if dot <= math.cos(math.rad(FOV_FLASHLIGHT / 2)) then continue end

            local dist = (targetHrp.Position - hrp.Position).Magnitude
            if dist < shortestDist then
                shortestDist = dist
                closestTarget = targetHead or targetHrp
            end
        end

        return closestTarget
    end

    local function AimAtFace(targetPart)
        if not targetPart then return end
        local camera = workspace.CurrentCamera
        local targetChar = targetPart.Parent
        local head = targetChar:FindFirstChild("Head")

        local aimPosition = head and head.Position or targetPart.Position + Vector3.new(0, 1.5, 0)
        local rightOffset = camera.CFrame.RightVector * 0.8
        local finalAimPos = aimPosition + rightOffset

        local currentCFrame = camera.CFrame
        local targetCFrame = CFrame.lookAt(currentCFrame.Position, finalAimPos)

        camera.CFrame = currentCFrame:Lerp(targetCFrame, 0.55)
    end

    local function StartFlashlightAim()
        if FlashlightThread then return end
        FlashlightThread = task.spawn(function()
            while FlashlightAimEnabled do
                if IsPlayerInLobby() then
                    task.wait(0.5)
                    continue
                end

                local isHolding = FlashlightAiming or FlashlightMobileHeld
                if isHolding then
                    local target = GetFlashlightTarget()
                    if target then
                        AimAtFace(target)
                    end
                end
                task.wait()
            end
        end)
    end

    local function StopFlashlightAim()
        if FlashlightThread then
            pcall(task.cancel, FlashlightThread)
            FlashlightThread = nil
        end
    end

    UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not FlashlightAimEnabled then return end
        if UserInputService.GamepadEnabled then
            if input.KeyCode == Enum.KeyCode.ButtonL2 then FlashlightAiming = true end
        else
            if input.UserInputType == Enum.UserInputType.MouseButton2 then FlashlightAiming = true end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not FlashlightAimEnabled then return end
        if UserInputService.GamepadEnabled then
            if input.KeyCode == Enum.KeyCode.ButtonL2 then FlashlightAiming = false end
        else
            if input.UserInputType == Enum.UserInputType.MouseButton2 then FlashlightAiming = false end
        end
    end)

    local function SetupFlashlightMobile()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
        if not playerGui then return end

        local currentConnections = {}

        local function ClearMobileConnections()
            for _, conn in ipairs(currentConnections) do
                if conn then conn:Disconnect() end
            end
            table.clear(currentConnections)
        end

        local function HookGuiMob(guiMob)
            ClearMobileConnections()

            table.insert(currentConnections, guiMob.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    FlashlightMobileHeld = true
                end
            end))

            table.insert(currentConnections, guiMob.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    FlashlightMobileHeld = false
                end
            end))
        end

        local function CheckAndHookSurvivorMob(survivorMob)
            if not survivorMob or survivorMob.Name ~= "Survivor-mob" then return end

            local controls = survivorMob:WaitForChild("Controls", 5)
            if not controls then return end

            local guiMob = controls:WaitForChild("Gui-mob", 5)
            if guiMob then
                HookGuiMob(guiMob)
            end
        end

        -- Cek jika UI sudah ada saat script berjalan
        local existingMob = playerGui:FindFirstChild("Survivor-mob")
        if existingMob then
            task.spawn(CheckAndHookSurvivorMob, existingMob)
        end

        -- Pantau setiap kali Survivor-mob muncul di match/round baru
        playerGui.ChildAdded:Connect(function(child)
            if child.Name == "Survivor-mob" then
                task.spawn(CheckAndHookSurvivorMob, child)
            end
        end)
    end

    if isMobile then SetupFlashlightMobile() end

    LocalPlayer.CharacterAdded:Connect(function()
        FlashlightAiming = false
        FlashlightMobileHeld = false
    end)

    FlashlightToggle = FlashlightSection:AddToggle({
        Title = "Enable Aimbot Flashlight",
        Default = false,
        Keybind = true,
        Callback = function(v)
            FlashlightAimEnabled = v
            SendNotif("flashlight aimbot: " .. (v and "enabled" or "disabled"))

            if v then
                StartFlashlightAim()
            else
                StopFlashlightAim()
                FlashlightAiming = false
                FlashlightMobileHeld = false
            end
        end
    })

    _G.setAimbotFlashlight = function(v)
        FlashlightToggle:Set(not FlashlightToggle.Value)
    end
end

do 
    local ToFEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Items")["Twist of Fate"].Fire
    local silentAimEnabled = false
    local silentAimSafety = false
    local silentAimPredict = false
    local laserEnabled = false
    local wallcheckEnabled = false
    local isAiming = false
    local Connection = nil
    local LaserBeam = nil
    local silentAimGui = nil
    local targetMode = "Killer"
    local savedUIPos = UDim2.new(0.5, -120, 0, 110)
    local btnRefs = {}
    local lastShootTime = 0
    local SHOOT_HIT_WINDOW = 1.5
    local mobileSetupConn = nil
    local mobileButtonConns = {}

    local hitSoundEnabled = false
    local hitSoundType = "Coin"
    local hitSoundIds = {
        ["Click"] = "rbxassetid://140207837688369",
        ["Coin"]  = "rbxassetid://135483737426662",
        ["Fist"] = "rbxassetid://140604838213617",
        ["Meme"] = "rbxassetid://135602581462761",
        ["Meme 2"] = "rbxassetid://95942836778998",
        ["Critical"] = "rbxassetid://140181868959125"
    }
    local lastTargetHealth = {}
    local lastKillerStunned = {}
    

    local function playHitSound()
        if not hitSoundEnabled then return end
        local id = hitSoundIds[hitSoundType] or hitSoundIds["Coin"]
        local sound = Instance.new("Sound")
        sound.SoundId = id
        sound.Volume = 5
        sound.RollOffMaxDistance = 0
        sound.Parent = workspace
        sound:Play()
        game:GetService("Debris"):AddItem(sound, 2)
    end

    local function getGunObject()
        local char = LocalPlayer.Character
        if not char then return nil end
        local baseToF = char:FindFirstChild("Twist of Fate", true)
        if not baseToF then return nil end
        local rightArm = baseToF:FindFirstChild("Right Arm")
        if rightArm then
            local gunPart = rightArm:FindFirstChild("gun")
            if gunPart then return gunPart end
            local emperorGun = rightArm:FindFirstChild("EmperorGun")
            if emperorGun then return emperorGun end
        end
        return baseToF
    end

    local function isTargetVisible(originPos, torsoPos, targetCharacter)
        local direction = torsoPos - originPos
        local distance = direction.Magnitude
        if distance < 0.1 then return true end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local excludeList = {}
        local localChar = LocalPlayer.Character
        if localChar then
            table.insert(excludeList, localChar)
        end
        if targetCharacter and targetCharacter ~= localChar then
            table.insert(excludeList, targetCharacter)
        end
        if LaserBeam then
            table.insert(excludeList, LaserBeam)
        end

        rayParams.FilterDescendantsInstances = excludeList

        local result = workspace:Raycast(originPos, direction.Unit * distance, rayParams)
        return result == nil
    end

    local velocityCache = {}

    local function getTargetVelocity(targetCharacter)
        local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
        if not rootPart then return Vector3.zero, false end

        local currentPos = rootPart.Position
        local currentRawVel = rootPart.Velocity
        local cached = velocityCache[targetCharacter]
        local now = tick()
        
        if cached then
            local timeDelta = now - cached.time
            if timeDelta > 0.001 and timeDelta < 0.15 then
                local calculatedVel = (currentPos - cached.pos) / timeDelta
                
                if calculatedVel.Magnitude < 1.5 then
                    calculatedVel = Vector3.zero
                end

                local oldDir = cached.vel.Magnitude > 0.1 and cached.vel.Unit or Vector3.zero
                local newDir = calculatedVel.Magnitude > 0.1 and calculatedVel.Unit or Vector3.zero
                
                local dirDot = 1
                if oldDir.Magnitude > 0 and newDir.Magnitude > 0 then
                    dirDot = oldDir:Dot(newDir)
                end

                local isStrafing = dirDot < 0.5 and calculatedVel.Magnitude > 4

                local finalVel
                if isStrafing then
                    finalVel = calculatedVel:Lerp(currentRawVel, 0.5)
                    
                    finalVel = finalVel * 0.4 
                else
                    finalVel = cached.vel:Lerp(calculatedVel, 0.45)
                end
                
                velocityCache[targetCharacter] = {
                    pos = currentPos,
                    vel = finalVel,
                    time = now,
                    strafing = isStrafing
                }
                return finalVel, isStrafing
            end
        end

        velocityCache[targetCharacter] = {
            pos = currentPos,
            vel = currentRawVel,
            time = now,
            strafing = false
        }
        return currentRawVel, false
    end

    local BODY_PARTS = {
        "HumanoidRootPart", "UpperTorso", "Torso", "Head",
        "RightUpperArm", "LeftUpperArm", "RightHand", "LeftHand",
        "RightLowerArm", "LeftLowerArm", "RightLowerLeg", "LeftLowerLeg", "RightFoot", "LeftFoot"
    }

    local function getBestVisiblePart(targetCharacter, originPos)
        if not targetCharacter then return nil end
        
        -- 1. Cek dulu bagian utama (HRP / Torso / Head)
        local mainParts = {"HumanoidRootPart", "UpperTorso", "Torso", "Head"}
        for _, partName in ipairs(mainParts) do
            local part = targetCharacter:FindFirstChild(partName)
            if part and (not wallcheckEnabled or isTargetVisible(originPos, part.Position, targetCharacter)) then
                return part
            end
        end

        -- 2. Jika bagian utama terhalang obstacle, scan bagian tangan / kaki yang mengintip
        for _, partName in ipairs(BODY_PARTS) do
            local part = targetCharacter:FindFirstChild(partName)
            if part and part:IsA("BasePart") then
                if not wallcheckEnabled or isTargetVisible(originPos, part.Position, targetCharacter) then
                    return part
                end
            end
        end

        -- Jika wallcheck dimatikan, kembalikan HRP bawaan
        return targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso")
    end

    local function getTargetPosition()
        local cam = workspace.CurrentCamera
        local gunObj = getGunObject()
        local char = LocalPlayer.Character
        if not (gunObj and char) then return nil, nil, nil, nil end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil, nil, nil, nil end

        local myPos = hrp.Position
        local originPos
        if char:GetAttribute("IsCarried") then
            originPos = char.HumanoidRootPart.Position + (char.HumanoidRootPart.CFrame.LookVector * 2)
        else
            pcall(function()
                originPos = gunObj:IsA("BasePart") and gunObj.Position 
                            or gunObj:FindFirstChildOfClass("BasePart") and gunObj:FindFirstChildOfClass("BasePart").Position
            end)
            originPos = originPos or Vector3.new(myPos.X, myPos.Y + 1.5, myPos.Z)
        end

        local function getRealTarget(targetPart, targetCharacter)
            local targetPos = targetPart.Position

            if wallcheckEnabled and not isTargetVisible(originPos, targetPos, targetCharacter) then
                return nil, nil, nil, nil
            end

            local checkOriginPos = originPos
            pcall(function()
                if gunObj and gunObj:IsA("BasePart") then
                    checkOriginPos = gunObj.Position
                elseif gunObj then
                    local part = gunObj:FindFirstChildOfClass("BasePart")
                    if part then checkOriginPos = part.Position end
                end
            end)

            return (targetPos - checkOriginPos).Unit, gunObj, checkOriginPos, targetPos
        end

        local function predictTarget(targetPart, targetCharacter)
            local targetPos = targetPart.Position
            
            if wallcheckEnabled and not isTargetVisible(originPos, targetPos, targetCharacter) then
                return nil, nil, nil, nil
            end

            local checkOriginPos = originPos
            pcall(function()
                if gunObj and gunObj:IsA("BasePart") then
                    checkOriginPos = gunObj.Position
                elseif gunObj then
                    local part = gunObj:FindFirstChildOfClass("BasePart")
                    if part then checkOriginPos = part.Position end
                end
            end)

            local distance = (targetPos - checkOriginPos).Magnitude

            if distance < 8 or not silentAimPredict then
                return (targetPos - checkOriginPos).Unit, gunObj, checkOriginPos, targetPos
            end

            local targetVel, isStrafing = getTargetVelocity(targetCharacter)
            local bulletSpeed = 750
            
            -- FIX 1: Ambil HRP sebagai jangkar (anchor) biar aim stabil, gak kena jitter animasi tangan
            local hrp = targetCharacter:FindFirstChild("HumanoidRootPart")
            local centerPos = hrp and hrp.Position or targetPos
            
            -- FIX 2: Relative Velocity (Kompensasi kecepatan jalan lu sendiri)
            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local myVel = myHrp and myHrp.Velocity or Vector3.zero
            
            -- Kurangi target velocity dengan sebagian velocity kita biar sambil jalan tetep on-point
            local relativeVel = targetVel - (myVel * 0.5)
            local adjustedVel = Vector3.new(relativeVel.X, relativeVel.Y * 0.3, relativeVel.Z)

            local relativePos = centerPos - checkOriginPos

            local a = adjustedVel:Dot(adjustedVel) - (bulletSpeed * bulletSpeed)
            local b = 2 * relativePos:Dot(adjustedVel)
            local c = relativePos:Dot(relativePos)

            local timeToHit = distance / bulletSpeed
            local discriminant = b * b - 4 * a * c
            if discriminant >= 0 then
                local sqrtD = math.sqrt(discriminant)
                local t1 = (-b - sqrtD) / (2 * a)
                local t2 = (-b + sqrtD) / (2 * a)
                
                if t1 > 0.001 and t1 < t2 then
                    timeToHit = t1
                elseif t2 > 0.001 then
                    timeToHit = t2
                end
            end

            local networkStats = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]
            local pingSeconds = (networkStats and networkStats:GetValue() or 70) / 1000
            local totalTime = timeToHit + (pingSeconds * 0.85)

            if isStrafing then
                totalTime = totalTime * 0.35 
            end

            local camCFrame = workspace.CurrentCamera.CFrame
            local relativeCamVel = camCFrame:VectorToObjectSpace(adjustedVel)

            if relativeCamVel.X < -0.5 then
                local leftBoost = math.clamp(1.28 + (distance / 900), 1.25, 1.48)
                totalTime = totalTime * leftBoost

                if not isStrafing then
                    local leadDirection = adjustedVel.Unit
                    local extraLeadOffset = leadDirection * math.clamp(distance / 85, 0.8, 1.8)
                    centerPos = centerPos + extraLeadOffset 
                end
            end

            local maxLeadTime = math.clamp(distance / 400, 0.02, 0.32)
            totalTime = math.clamp(totalTime, 0.001, maxLeadTime)

            local predictedCenter = centerPos + (adjustedVel * totalTime)
            local limbOffset = targetPos - (hrp and hrp.Position or targetPos)
            
            local targetDirToMe = (centerPos - checkOriginPos).Unit
            local moveDir = adjustedVel.Magnitude > 0 and adjustedVel.Unit or Vector3.zero
            
            local sideProfileDot = math.abs(targetDirToMe:Dot(moveDir)) 
            
            if sideProfileDot < 0.65 and adjustedVel.Magnitude > 5 then
                limbOffset = Vector3.zero 
                predictedCenter = predictedCenter + (moveDir * 0.85) 
            end
            
            local predictedPos = predictedCenter + limbOffset

            return (predictedPos - checkOriginPos).Unit, gunObj, checkOriginPos, predictedPos
        end

        if targetMode == "Killer" then
            local closestPart = nil
            local closestChar = nil
            local shortestDist = math.huge

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Team and player.Team.Name == "Killer" and player.Character then
                    -- Gunakan Multi-Part Scanner
                    local targetPart = getBestVisiblePart(player.Character, originPos)
                    if targetPart then
                        local dist = (myPos - targetPart.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestPart = targetPart
                            closestChar = player.Character
                        end
                    end
                end
            end

            if not closestPart then return nil, nil, nil, nil end
            local _, _, _, realPos = getRealTarget(closestPart, closestChar)
            local dir, gun, origin, aimPos = predictTarget(closestPart, closestChar)
            return dir, gun, origin, aimPos, realPos

        elseif targetMode == "Survivors" then
            local bestPart = nil
            local bestChar = nil
            local bestDot = -math.huge
            local cam = workspace.CurrentCamera
            local camLook = cam.CFrame.LookVector

            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Team and player.Team.Name == "Survivors" and player.Character then
                    local char = player.Character

                    if not (char:GetAttribute("Knocked") or char:GetAttribute("IsHooked")) then
                        -- Gunakan Multi-Part Scanner
                        local targetPart = getBestVisiblePart(char, originPos)
                        
                        if targetPart then
                            local dirToTarget = (targetPart.Position - cam.CFrame.Position).Unit
                            local dot = camLook:Dot(dirToTarget)
                            
                            if dot > 0.5 and dot > bestDot then
                                bestDot = dot
                                bestPart = targetPart
                                bestChar = player.Character
                            end
                        end
                    end
                end
            end

            if not bestPart then return nil, nil, nil, nil end
            local _, _, _, realPos = getRealTarget(bestPart, bestChar)
            local dir, gun, origin, aimPos = predictTarget(bestPart, bestChar)
            return dir, gun, origin, aimPos, realPos

        elseif targetMode == "Zombie" then
            local targets = GetSCPs()
            local bestPart = nil
            local bestDot = -math.huge
            local cam = workspace.CurrentCamera
            local camLook = cam.CFrame.LookVector

            for _, part in ipairs(targets) do
                if part and part.Parent then
                    local dirToTarget = (part.Position - cam.CFrame.Position).Unit
                    local dot = camLook:Dot(dirToTarget)
                    
                    if dot > 0.5 and dot > bestDot then
                        bestDot = dot
                        bestPart = part
                    end
                end
            end
            if not bestPart then return nil, nil, nil, nil end
            
            local zombieChar = bestPart.Parent
            local centerPart = zombieChar:FindFirstChild("HumanoidRootPart") or 
                               zombieChar:FindFirstChild("UpperTorso") or 
                               bestPart
            
            local _, _, _, realPos = getRealTarget(centerPart, zombieChar)
            local dir, gun, origin, aimPos = predictTarget(centerPart, zombieChar)
            return dir, gun, origin, aimPos, realPos
        end

        return nil, nil, nil, nil
    end

