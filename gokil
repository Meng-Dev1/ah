    task.spawn(function()
        local triggeredAction = {}

        while true do
            if parryEnabled and parrySkillCounter then
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                
                if root then
                    for _, pl in ipairs(Players:GetPlayers()) do
                        if pl ~= LocalPlayer and pl.Team and pl.Team.Name == "Killer" then
                            local killerChar = pl.Character
                            local killerRoot = killerChar and killerChar:FindFirstChild("HumanoidRootPart")
                            local killerHum = killerChar and killerChar:FindFirstChildOfClass("Humanoid")
                            
                            if killerRoot and killerHum then
                                local animator = killerHum:FindFirstChildOfClass("Animator")
                                local isHiddenDash, isMaskedSaw = false, false
                                
                                if animator then
                                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                        local animId = tostring(track.Animation.AnimationId)
                                        if string.find(animId, "98163597193511") then
                                            isHiddenDash = true
                                            break
                                        elseif string.find(animId, "106871536134254") then
                                            isMaskedSaw = true
                                            break
                                        end
                                    end
                                end

                                local dist = (killerRoot.Position - root.Position).Magnitude
                                local function executeParry()
                                    pcall(function()
                                        local cChar = LocalPlayer.Character
                                        local cRoot = cChar and cChar:FindFirstChild("HumanoidRootPart")
                                        
                                        if cChar and cRoot and killerRoot then
                                            if not canParry(cChar, cRoot) then return end
                                            if parryOnCooldown then return end
                                            
                                            if isMobile then
                                                pcall(function()
                                                    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                                                    local controls = pg and pg:FindFirstChild("Survivor-mob") and pg["Survivor-mob"]:FindFirstChild("Controls")
                                                    local btn = controls and controls:FindFirstChild("Gui-mob")
                                                    if btn then firesignal(btn.MouseButton1Down) firesignal(btn.MouseButton1Up) end
                                                end)
                                            elseif UserInputService.GamepadEnabled then
                                                VIM:SendKeyEvent(true, Enum.KeyCode.ButtonL2, false, game)
                                                VIM:SendKeyEvent(false, Enum.KeyCode.ButtonL2, false, game)
                                            else
                                                pcall(function()
                                                    mouse2press()
                                                    mouse2release()
                                                end)
                                            end
                                        end
                                    end)
                                end

                                if isHiddenDash and dist <= 60 and not triggeredAction[pl] then
                                    triggeredAction[pl] = true
                                    task.spawn(function()
                                        task.wait(0.95)
                                        
                                        local shouldParry = true 
                                        local currentMobChar = LocalPlayer.Character
                                        local currentMobRoot = currentMobChar and currentMobChar:FindFirstChild("HumanoidRootPart")
                                        
                                        if killerChar and currentMobChar and currentMobRoot then
                                            local head = killerChar:FindFirstChild("Head") or killerRoot
                                            if head then
                                                local distanceToMe = (currentMobRoot.Position - head.Position).Magnitude
                                                
                                                local raycastParams = RaycastParams.new()
                                                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                                                raycastParams.FilterDescendantsInstances = {killerChar, currentMobChar}
                                                raycastParams.IgnoreWater = true
                                                
                                                local raycastResult = workspace:Raycast(head.Position, (currentMobRoot.Position - head.Position), raycastParams)
                                                if raycastResult then
                                                    shouldParry = false
                                                end

                                                if distanceToMe > 1 then
                                                    local lookDir = head.CFrame.LookVector
                                                    local dirToMe = (currentMobRoot.Position - head.Position).Unit
                                                    local dot = lookDir:Dot(dirToMe)
                                                    
                                                    if dot < 0 and distanceToMe > 15 then
                                                        shouldParry = false
                                                    end
                                                end
                                            end
                                        end
                                        
                                        if shouldParry then
                                            executeParry()
                                        end
                                    end)
                                    task.delay(2.5, function() triggeredAction[pl] = false end)

                                elseif isMaskedSaw and dist <= (parryRange + 3) and not triggeredAction[pl] then
                                    triggeredAction[pl] = true
                                    executeParry()
                                    task.delay(2.0, function() triggeredAction[pl] = false end)

                                elseif not isHiddenDash and not isMaskedSaw then
                                    triggeredAction[pl] = false
                                end
                            end
                        end
                    end
                end
            end
            task.wait()
        end
    end)

