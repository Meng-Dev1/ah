    local function getShootAnimId()
        local skin = LocalPlayer:GetAttribute("EquippedSkin_Twist_of_Fate") or ""
        if skin:find("AWP") or skin:find("Awp") or skin:find("awp") then
            return "rbxassetid://119691839016468"
        elseif skin:find("SCP") or skin:find("3108") then
            return "rbxassetid://116394362601423"
        else
            return "rbxassetid://124735239320776"
        end
    end

    local function setupBlockShootAnim()
        for _, conn in ipairs(blockedAnimConns) do
            conn:Disconnect()
        end
        blockedAnimConns = {}

        local char = LocalPlayer.Character
        if not char then return end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        if not animator then return end

        local function shouldBlock()
            return char:GetAttribute("IsCarried") or char:GetAttribute("Knocked")
        end

        local function getBlockedIds()
            return {
                [getShootAnimId()] = true,
                ["rbxassetid://111824163160605"] = true,
                ["rbxassetid://72749744367268"] = true, -- sniper
            }
        end

        table.insert(blockedAnimConns, animator.AnimationPlayed:Connect(function(track)
            if not shouldBlock() then return end
            if not track.Animation then return end
            local blocked = getBlockedIds()
            if blocked[track.Animation.AnimationId] then
                track:Stop(0)
            end
        end))

        table.insert(blockedAnimConns, char:GetAttributeChangedSignal("IsCarried"):Connect(function()
            if not shouldBlock() then return end
            local blocked = getBlockedIds()
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track.Animation and blocked[track.Animation.AnimationId] then
                    track:Stop(0)
                end
            end
        end))

        table.insert(blockedAnimConns, char:GetAttributeChangedSignal("Knocked"):Connect(function()
            if not shouldBlock() then return end
            local blocked = getBlockedIds()
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                if track.Animation and blocked[track.Animation.AnimationId] then
                    track:Stop(0)
                end
            end
        end))
    end

