        cache.headPos = lhead.Position
        local look = lhrp.CFrame.LookVector
        cache.lookX, cache.lookZ = look.X, look.Z

        local cam = workspace.CurrentCamera
        local best, bestW = nil, math.huge
        if cam then
            local vp = cam.ViewportSize
            local center = vp * 0.5
            local radius = (ButcherFOVDegree / 180) * math.min(vp.X, vp.Y) * 1.8

            for i = 1, #cachedChainTargets do
                local char = cachedChainTargets[i]
                if isChainTargetValid(char) then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local dist = (hrp.Position - cache.headPos).Magnitude
                        if dist <= CHAIN_RANGE then
                            local sp, onScreen = cam:WorldToViewportPoint(hrp.Position)
                            if onScreen and sp.Z > 0 then
                                local d2 = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                                if d2 <= radius then
                                    local w = dist * 0.7 + d2 * 0.3
                                    if w < bestW then
                                        bestW = w
                                        best = char
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end

        if best then
            local v = smoothVel(best)
            cache.pos = best.HumanoidRootPart.Position
            cache.vel = Vector3.new(v.X, 0, v.Z)
            cache.hasTarget = true
        else
            cache.hasTarget = false
        end
    end)

    local function predictDir(origin)
        local vx, vz = cache.vel.X, cache.vel.Z
        local aimX, aimY, aimZ = cache.pos.X, cache.pos.Y, cache.pos.Z
        for _ = 1, 3 do
            local dx, dy, dz = aimX - origin.X, aimY - origin.Y, aimZ - origin.Z
            local t = math.sqrt(dx * dx + dy * dy + dz * dz) / CHAIN_SPEED
            aimX = cache.pos.X + vx * t
            aimZ = cache.pos.Z + vz * t
        end
        local dx, dy, dz = aimX - origin.X, aimY - origin.Y, aimZ - origin.Z
        local m = math.sqrt(dx * dx + dy * dy + dz * dz)
        if m < 0.01 then return nil end
        return Vector3.new(dx / m, dy / m, dz / m)
    end

    local function allowedPure(dir)
        local fx, fz = dir.X, dir.Z
        local fm = math.sqrt(fx * fx + fz * fz)
        if fm <= 0.2 then return true end
        local lx, lz = cache.lookX, cache.lookZ
        local lm = math.sqrt(lx * lx + lz * lz)
        if lm < 0.001 then return true end
        return (fx * lx + fz * lz) / (fm * lm) >= -0.2
    end

    local mt = getrawmetatable(game)
    local oldNamecall = mt.__namecall
    setreadonly(mt, false)
    local busy = false

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if busy or not ButcherSilentEnabled or self ~= ChainRemote
            or not cache.hasTarget or not cache.hasLook or method ~= "FireServer" then
            return oldNamecall(self, ...)
        end

        local args = { ... }
        if typeof(args[1]) ~= "Vector3" then
            return oldNamecall(self, ...) 
        end

        local origin = cache.headPos
        if typeof(args[3]) == "table" and typeof(args[3].Origin) == "Vector3" then
            origin = args[3].Origin
        end

        local dir = predictDir(origin)
        if not dir or not allowedPure(dir) then
            return oldNamecall(self, ...)
        end

        args[1] = dir

        busy = true
        local ok, err = pcall(function()
            self.FireServer(self, unpack(args))
        end)
        busy = false

        if not ok then
            warn("[ButcherSilent] gagal kirim:", err)
        end
    end)
    setreadonly(mt, true)

