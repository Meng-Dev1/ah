                Instance.new("UICorner", sb).CornerRadius = UDim.new(0,4)
                stepBtns[s] = sb
                sb.MouseButton1Click:Connect(function()
                    STEP = s
                    for sv, b in pairs(stepBtns) do
                        b.BackgroundColor3 = sv==s and Color3.fromRGB(25,52,95) or Color3.fromRGB(20,20,26)
                        b.TextColor3 = sv==s and Color3.fromRGB(90,150,255) or Color3.fromRGB(100,100,112)
                    end
                end)
            end

            local arrowY = stepY + 30
            local startX = (panelW - (arrowSz*3+arrowGap*2)) / 2

            local function makeArrow(label, gx, gy, dx, dy)
