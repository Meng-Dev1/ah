                Thickness = 1,
                Transparency = 0.4
            }),
            Create("UIPadding", {
                PaddingTop = UDim.new(0, isMobile and 10 or 14),
                PaddingLeft = UDim.new(0, isMobile and 10 or 14),
                PaddingRight = UDim.new(0, isMobile and 10 or 14),
                PaddingBottom = UDim.new(0, isMobile and 10 or 14)
            }),
            Create("UIListLayout", {
