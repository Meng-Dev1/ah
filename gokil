    title.Text = "Mob Panel"
    title.TextColor3 = Color3.fromRGB(245, 245, 245)
    title.Font = Enum.Font.Code
    title.TextSize = 14

    local sep = Instance.new("Frame", header)
    sep.Size = UDim2.new(1, -16, 0, 1)
    sep.Position = UDim2.new(0, 8, 1, -1)
    sep.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    sep.BorderSizePixel = 0

    MakeDraggable(frame, header)

    local scrolling = Instance.new("ScrollingFrame")
    scrolling.Size = UDim2.new(1, 0, 1, -36)
    scrolling.Position = UDim2.new(0, 0, 0, 36)
    scrolling.BackgroundTransparency = 1
    scrolling.ScrollBarThickness = 3
    scrolling.ScrollBarImageColor3 = Color3.fromRGB(65, 65, 65)
    scrolling.CanvasSize = UDim2.new(0, 0, 0, totalContentHeight)
    scrolling.Parent = frame

    for i, feat in ipairs(MobFeatures) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, ITEM_H)
        row.Position = UDim2.new(0, 0, 0, (i-1) * ITEM_H)
        row.BackgroundTransparency = 1
        row.Text = ""
        row.AutoButtonColor = false
        row.Parent = scrolling

        local box = Instance.new("Frame", row)
        box.Size = UDim2.new(0, 15, 0, 15)
        box.Position = UDim2.new(0, 12, 0.5, -7.5)
        box.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
        box.BorderSizePixel = 0
        Instance.new("UICorner", box).CornerRadius = UDim.new(0, 3)

        local bstroke = Instance.new("UIStroke", box)
        bstroke.Color = Color3.fromRGB(70, 70, 70)
        bstroke.Thickness = 1.3

        local checkmark = Instance.new("TextLabel", box)
        checkmark.Size = UDim2.new(1, 0, 1, 0)
        checkmark.BackgroundTransparency = 1
        checkmark.Text = "✓"
        checkmark.TextColor3 = Color3.fromRGB(230, 255, 230)
        checkmark.Font = Enum.Font.Code
        checkmark.TextSize = 12
        checkmark.Visible = CheckStates[feat.id] or false

        local lbl = Instance.new("TextLabel", row)
        lbl.Size = UDim2.new(1, -44, 1, 0)
        lbl.Position = UDim2.new(0, 35, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = feat.tag
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 13
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextColor3 = CheckStates[feat.id] and Color3.fromRGB(245, 245, 245) or Color3.fromRGB(165, 165, 165)

        row.Activated:Connect(function()
            if feat.premium and not IsProviderPremium then
                SendNotif("unlock this with premium!")
                return
            end

            CheckStates[feat.id] = not (CheckStates[feat.id] or false)
            checkmark.Visible = CheckStates[feat.id]
            lbl.TextColor3 = CheckStates[feat.id] and Color3.fromRGB(245, 245, 245) or Color3.fromRGB(165, 165, 165)

            if CheckStates[feat.id] then
                createLabelGui(feat)
            else
                if LabelGuis[feat.id] then
                    LabelGuis[feat.id]:Destroy()
                    LabelGuis[feat.id] = nil
                end
                if ActiveStates[feat.id] then
                    ActiveStates[feat.id] = false
                    pcall(feat.off)
                end
            end
        end)
    end
end

