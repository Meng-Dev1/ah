    local function getBestTarget(originPos)
        local best, bestPart, bestPos2D = nil, nil, nil
        local shortestWeight = math.huge
        local screenCenter = Camera.ViewportSize * 0.5
        local fovRadius = getFOVRadius()

        for i = 1, #cachedTargets do
            local t = cachedTargets[i]
            local part = t.part

            local dist3D = (part.Position - originPos).Magnitude
            if dist3D <= (MAX_RANGE + 5) then
                local pos2D, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and pos2D.Z > 0 then
                    local v2D = Vector2.new(pos2D.X, pos2D.Y)
                    local dist2D = (v2D - screenCenter).Magnitude

                    if dist2D <= fovRadius then
                        local weight = dist3D * 0.65 + dist2D * 0.35
                        if weight < shortestWeight then
                            shortestWeight = weight
                            best = t
                            bestPart = part
                            bestPos2D = v2D
                        end
                    end
                end
            end
        end

        return best, bestPart, bestPos2D
    end

