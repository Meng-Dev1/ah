    sg.ResetOnSpawn = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = CoreGui
    PanelGui = sg

    local ITEM_H = 26
    local totalContentHeight = 36 + (#MobFeatures * ITEM_H) + 10

