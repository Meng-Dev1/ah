    local function tryForceVault()
        if not AutoFastVault then return end
        
        local now = os.clock()
        if now - lastVault < COOLDOWN then return end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then return end
        
        local hrpPos = hrp.Position
        local vaultPoint = nil
        
        for i = 1, #cachedVaultPoints do
            local v = cachedVaultPoints[i]
            if v and v.Parent then
                local pos = v.Position
                local dx = pos.X - hrpPos.X
                local dy = pos.Y - hrpPos.Y
                local dz = pos.Z - hrpPos.Z
                local distSq = dx*dx + dy*dy + dz*dz
                
                if distSq <= VAULT_RADIUS_SQ then
                    vaultPoint = v
                    break
                end
            end
        end
        
        if vaultPoint and vaultEvent then
            lastVault = now
            char:SetAttribute("Sprinting", true)
            vaultEvent:FireServer(vaultPoint, true)
        end
    end

