    local function getMapFolders()
        local folders = {}
        local map = workspace:FindFirstChild("Map")
        if map then
            table.insert(folders, map)
            for _, c in pairs(map:GetChildren()) do
                if c:IsA("Folder") or c:IsA("Model") then
