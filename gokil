do
    local SpearSilentAimEnabled = false
    local GravityScale = 0.55
    local AutoPredictionEnabled = true
    local SnaplineEnabled = false
    local SnaplineColor = Color3.fromRGB(255, 50, 80)
    local FOVDegree = 30
    local FOVCircleShow = false

    local Spearthrow = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Killers"):WaitForChild("Veil"):WaitForChild("Spearthrow")
    local MAX_RANGE = 330
    local SPEAR_SPEED = 180

    local HitSoundEnabled = true
    local HIT_SOUND_ID = "rbxassetid://140462043853173"

    local pendingHit = nil

    local function playSpearHitSound()
        pcall(function()
            local sound = Instance.new("Sound")
            sound.SoundId = HIT_SOUND_ID
            sound.Volume = 1
            sound.Parent = SoundService
            sound:Play()
            sound.Ended:Connect(function()
                sound:Destroy()
            end)
            task.delay(3, function()
                if sound and sound.Parent then
                    sound:Destroy()
                end
            end)
        end)
    end

    RunService.Heartbeat:Connect(function()
        if not SpearSilentAimEnabled then return end
        if not pendingHit then return end
        if os.clock() > pendingHit.expire then
            pendingHit = nil
            return
        end

        local char = pendingHit.char
        local hum = pendingHit.hum
        if not char or not char.Parent or not hum or not hum.Parent then
            pendingHit = nil
            return
        end

        local hit = false
        if hum.Health < pendingHit.hp - 0.5 then
            hit = true
        elseif char:GetAttribute("Knocked") == true then
            hit = true
        end

        if hit then
            pendingHit = nil
            if HitSoundEnabled then
                playSpearHitSound()
            end
        end
    end)

    local SnaplineGui = Instance.new("ScreenGui")
    SnaplineGui.Name = "Delta_Snapline_UI"
    SnaplineGui.ResetOnSpawn = false
    SnaplineGui.IgnoreGuiInset = true
    SnaplineGui.Parent = (gethui and gethui()) or CoreGui or LocalPlayer:WaitForChild("PlayerGui")

    local LineFrame = Instance.new("Frame")
