                    if not root or not killerRoot then return end
                    if (killerRoot.Position - root.Position).Magnitude > parryRange + 1.5 then return end

                    if not parryOnCooldown then
                        if isMobile then
                            pcall(function()
                                local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                                local controls = pg and pg:FindFirstChild("Survivor-mob") and pg["Survivor-mob"]:FindFirstChild("Controls")
                                local btn = controls and controls:FindFirstChild("Gui-mob")
                                if btn then
                                    firesignal(btn.MouseButton1Down)
                                    task.wait(0.03)
                                    firesignal(btn.MouseButton1Up)
                                end
                            end)
