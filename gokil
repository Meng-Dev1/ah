                            VIM:SendKeyEvent(true, Enum.KeyCode.ButtonL2, false, game)
                            task.wait(0.03)
                            VIM:SendKeyEvent(false, Enum.KeyCode.ButtonL2, false, game)
                        else
                            pcall(function()
                                mouse2press()
                                task.wait(0.03)
                                mouse2release()
                            end)
                        end
                    end
                else
                    local startTime = tick()
                    while tick() - startTime < 0.22 do
                        if parryOnCooldown then return end
                        if doParry(pl) then return end
                        task.wait()
                    end
                end
            end)
        end))

        table.insert(conns, hum2.ChildAdded:Connect(function(child)
            if child.ClassName == "Animator" then
                task.wait(0.5)
                hookKiller(pl)
            end
        end))

