    local function SprintOn(char, hum)
        if not char then
            char, hum = GetCharacter()
        end
        if not char or not hum then return end
        if IsBlockedState(char) then return end

        local useMobileButton = isMobile and not mobileBtnMissing

        if useMobileButton and not IsActuallySprinting(char) then
            local now = os.clock()
            if now - lastSprintTry >= 0.7 then
                lastSprintTry = now
                if not TapMobileSprint() then
                    mobileBtnMissing = true
                end
            end
        end

        if not useMobileButton then
            if not shiftHeld then
                shiftHeld = true
                pcall(function()
                    VIM:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
                end)
            elseif not IsActuallySprinting(char) then
                local now = os.clock()
                if now - lastSprintTry >= 0.7 then
                    lastSprintTry = now
                    pcall(function()
                        VIM:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
                        task.wait(0.05)
                        VIM:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
                    end)
                end
            end
        end

        if hum.WalkSpeed > 0 and hum.WalkSpeed ~= RUN_SPEED then
            pcall(function()
                hum.WalkSpeed = RUN_SPEED
            end)
        end
    end

    local function SprintOff()
        if shiftHeld then
            shiftHeld = false
            pcall(function()
                VIM:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
            end)
        end

        local char, hum = GetCharacter()
        if char then
            if isMobile and not mobileBtnMissing and IsActuallySprinting(char) then
                TapMobileSprint()
            end
            char:SetAttribute("Sprinting", false)
            char:SetAttribute("IsRunning", false)
            if hum and savedWalkSpeed then
                hum.WalkSpeed = savedWalkSpeed
                savedWalkSpeed = nil
            end
        end
    end

    local function WalkToTarget(targetPos)
        local char, hum, hrp = GetCharacter()
        if not char then return false end

        if savedWalkSpeed == nil then
            savedWalkSpeed = hum.WalkSpeed
        end
        hum.AutoRotate = true
        SprintOn(char, hum)

        for attempt = 1, 4 do
            if not isFarming then
                StopMoving()
                return false
            end

            char, hum, hrp = GetCharacter()
            if not char then return false end
            SprintOn(char, hum)

            -- sedikit offset target ke bawah biar path milih anak tangga, bukan tralis
            local aimPos = targetPos
            local ok = pcall(function()
                NavPath:ComputeAsync(hrp.Position, aimPos)
            end)

            if not ok or NavPath.Status ~= Enum.PathStatus.Success then
                -- fallback: coba radius lebih kecil
                local altPath = PathfindingService:CreatePath({
                    AgentRadius = 1.2,
                    AgentHeight = 5,
                    AgentCanJump = true,
                    AgentJumpHeight = 12,
                    AgentMaxSlope = 60,
                    WaypointSpacing = 2.5,
                })
                ok = pcall(function()
                    altPath:ComputeAsync(hrp.Position, aimPos)
                end)
                if ok and altPath.Status == Enum.PathStatus.Success then
                    NavPath = altPath
                else
                    task.wait(0.2)
                    continue
                end
            end

            local waypoints = NavPath:GetWaypoints()
            if #waypoints < 2 then
                task.wait(0.15)
                continue
            end

            local needRecompute = false

            for i = 2, #waypoints do
                if not isFarming then
                    StopMoving()
                    return false
                end

                char, hum, hrp = GetCharacter()
                if not char then return false end
                SprintOn(char, hum)

                local wp = waypoints[i]
                local wpPos = wp.Position

                -- naik/turun tangga: kasih jump kalau beda tinggi signifikan
                local heightDiff = wpPos.Y - hrp.Position.Y
                if wp.Action == Enum.PathWaypointAction.Jump or heightDiff > 1.8 then
                    hum.Jump = true
                end

                hum:MoveTo(wpPos)

                local lastRefresh = os.clock()
                local lastPos = hrp.Position
                local lastCheck = os.clock()
                local lastStatus = 0
                local stuck = 0
                local timeout = os.clock() + 4.5

                while isFarming and os.clock() < timeout do
                    char, hum, hrp = GetCharacter()
                    if not char then return false end
                    SprintOn(char, hum)

                    local distToTarget = (hrp.Position - targetPos).Magnitude
                    if distToTarget <= 3.2 then
                        StopMoving()
                        return true
                    end

                    local distToWp = (hrp.Position - wpPos).Magnitude
                    -- longgar di tangga (beda Y)
                    local arriveDist = math.abs(heightDiff) > 1.2 and 4.0 or 2.8
                    if distToWp <= arriveDist then
                        break
                    end

                    local now = os.clock()

                    -- refresh MoveTo lebih jarang biar nggak kedut
                    if now - lastRefresh >= 0.55 then
                        hum:MoveTo(wpPos)
                        lastRefresh = now
                    end

                    if now - lastCheck >= 0.45 then
                        -- cuma hitung gerak horizontal (biar turun tangga nggak dianggap stuck)
                        local movedXZ = Vector3.new(
                            hrp.Position.X - lastPos.X,
                            0,
                            hrp.Position.Z - lastPos.Z
                        ).Magnitude
                        lastPos = hrp.Position
                        lastCheck = now

                        if now - lastStatus >= 0.6 then
                            lastStatus = now
                            SetStatus(string.format("go to pumpkin (%d studs)", math.floor(distToTarget)))
                        end

                        if movedXZ < 0.25 then
                            stuck = stuck + 1
                            if stuck == 2 then
                                hum.Jump = true
                                -- dorong sedikit ke arah waypoint
                                local dir = (wpPos - hrp.Position)
                                local flat = Vector3.new(dir.X, 0, dir.Z)
                                if flat.Magnitude > 0.1 then
                                    hum:MoveTo(hrp.Position + flat.Unit * 3 + Vector3.new(0, 0.5, 0))
                                end
                            elseif stuck >= 5 then
                                needRecompute = true
                                break
                            end
                        else
                            stuck = 0
                        end
                    end

                    task.wait()
                end

                if needRecompute then
                    break
                end
            end

            char, hum, hrp = GetCharacter()
            if char and (hrp.Position - targetPos).Magnitude <= 3.5 then
                StopMoving()
                return true
            end

            if needRecompute then
                task.wait(0.15)
            end
        end

        StopMoving()
        return false
    end

    local function StompInstant(targetModel)
        if not targetModel or not targetModel.Parent then return true end

        SetStatus("collect!")

        local useMobile = isMobile and not actionBtnMissing
        if useMobile and not GetMobileActionButton() then
            actionBtnMissing = true
            useMobile = false
        end

        if useMobile then task.wait(0.1) end

        for _ = 1, 4 do
            if not isFarming or not targetModel.Parent then return true end

            if useMobile then
                if not TapMobileAction() then
                    actionBtnMissing = true
                    useMobile = false
                end
            end

            if not useMobile then
                pcall(function()
                    VIM:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                    task.wait(0.03)
                    VIM:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                end)
            end

            task.wait(0.2)
        end

        return targetModel.Parent == nil
    end

    function StartPumpkinFarm()
        if isFarming then return end
        isFarming = true
        blacklistedPumpkins = {}
        shiftHeld = false
        lastSprintTry = 0
        mobileBtnMissing = false
        actionBtnMissing = false

        if StartStopBtn then
            StartStopBtn.Text = "STOP"
            StartStopBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
        end

        farmThread = task.spawn(function()
            while isFarming do
                local char, _, hrp = GetCharacter()

                if not char then
                    SetStatus("wait for respawn...")
                    task.wait(1)
                    continue
                end

                local pumpkins = GetPumpkinList()
                local total = #pumpkins

                if total == 0 then
                    SetSisa(0)
                    SetStatus("nothing pumpkin")
                    task.wait(0.8)
                    continue
                end

                SetSisa(total)

                local nearest, shortest = nil, math.huge
                for _, data in ipairs(pumpkins) do
                    if data.Part.Parent then
                        local dist = (hrp.Position - data.Part.Position).Magnitude
                        if dist < shortest then
                            shortest = dist
                            nearest = data
                        end
                    end
                end

                if not nearest then
                    task.wait(0.3)
                    continue
                end

                local arrived = WalkToTarget(nearest.Part.Position)

                if not isFarming then break end

                if arrived then
                    local destroyed = StompInstant(nearest.Model)

                    if not destroyed and isFarming and nearest.Model.Parent then
                        task.wait(0.35)
                        local _, _, hrp2 = GetCharacter()
                        if hrp2 and (hrp2.Position - nearest.Part.Position).Magnitude <= 7 then
                            destroyed = StompInstant(nearest.Model)
                        end
                    end

                    if not destroyed then
                        blacklistedPumpkins[nearest.Model] = os.clock() + SKIP_TIME
                    end
                else
                    SetStatus("Pumpkin is out of reach, switching targets.")
                    blacklistedPumpkins[nearest.Model] = os.clock() + SKIP_TIME
                end

                task.wait(0.1)
            end
        end)
    end

    function StopPumpkinFarm()
        isFarming = false

        if farmThread then
            pcall(task.cancel, farmThread)
            farmThread = nil
        end

        StopMoving()
        SprintOff()

        if StartStopBtn then
            StartStopBtn.Text = "START"
            StartStopBtn.BackgroundColor3 = Color3.fromRGB(45, 180, 80)
        end

        SetStatus("Idle (stopped)")
    end

