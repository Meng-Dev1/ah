        if distance < 0.1 then return true end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local excludeList = {}
        local localChar = LocalPlayer.Character
        if localChar then
            table.insert(excludeList, localChar)
        end
        if killerCharacter then
            table.insert(excludeList, killerCharacter)
        end

        rayParams.FilterDescendantsInstances = excludeList

        local result = workspace:Raycast(originPos, direction.Unit * distance, rayParams)
        return result == nil
    end

    local function canParry(char, root)
        if not char or not root then return false end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool:FindFirstChild("ParryClient") then
            local success, canUse = pcall(function()
                local modules = require(tool.ParryClient)
                return modules and modules.CanUse and modules:CanUse()
            end)
            if success and canUse == false then
                return false
            end
        end

        local interactObj = char:FindFirstChild("CheckInterractable")
        if interactObj then
            if interactObj:GetAttribute("isVaulting") then return false end
            -- if interactObj:GetAttribute("isRepairing") then return false end
            if interactObj:GetAttribute("isUnhooking") then return false end
            if interactObj:GetAttribute("isHealing") then return false end
            if interactObj:GetAttribute("isSliding") then return false end
        end

        if char:GetAttribute("IsCarried") or char:GetAttribute("IsHooked") then return false end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health < hum.MaxHealth * 0.5 then
            return false 
        end

        return true
    end

    local parryOnCooldown = false
    local parryResult = game:GetService("ReplicatedStorage").Remotes.Items["Parrying Dagger"].parryResult
    parryResult.OnClientEvent:Connect(function(success, cooldown)
        local cd = tonumber(cooldown)
        if cd and cd > 0 then
            parryOnCooldown = true
            task.delay(cd, function()
                parryOnCooldown = false
            end)
        end
    end)

    local function doParry(killer)
        if not parryEnabled then return false end
        if parryOnCooldown then return false end
        if not killer or not killer.Character then return false end

        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root or not root.Parent then return false end

        local killerRoot = killer.Character:FindFirstChild("HumanoidRootPart")
        if not killerRoot then return false end

        if (killerRoot.Position - root.Position).Magnitude > parryRange + 1 then return false end
        if not canParry(char, root) then return false end

        if not hasLineOfSightToKiller(root.Position, killerRoot.Position, killer.Character) then return end

        local killerPos2D = Vector3.new(killerRoot.Position.X, 0, killerRoot.Position.Z)
        local myPos2D = Vector3.new(root.Position.X, 0, root.Position.Z)
        local killerLook2D = Vector3.new(killerRoot.CFrame.LookVector.X, 0, killerRoot.CFrame.LookVector.Z).Unit
        local dirToMe = (myPos2D - killerPos2D).Unit
        if killerLook2D:Dot(dirToMe) < facingThreshold then return false end

        local tool = char:FindFirstChildOfClass("Tool")
        if tool and tool:GetAttribute("isOnCooldown") then return false end

        if isMobile then
            pcall(function()
                local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                local controls = pg and pg:FindFirstChild("Survivor-mob") and pg["Survivor-mob"]:FindFirstChild("Controls")
                local btn = controls and controls:FindFirstChild("Gui-mob")
                if btn then
                    firesignal(btn.MouseButton1Down)
                    task.wait(0.05)
                    firesignal(btn.MouseButton1Up)
                end
            end)
        elseif UserInputService.GamepadEnabled then
            VIM:SendKeyEvent(true, Enum.KeyCode.ButtonL2, false, game)
            task.wait(0.05)
            VIM:SendKeyEvent(false, Enum.KeyCode.ButtonL2, false, game)
        else
            pcall(function()
                mouse2press()
                task.wait(0.05)
                mouse2release()
            end)
        end
        return true
    end

