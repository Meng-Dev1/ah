                            lastKSStatus = "Active"
                        else
                            status.Text = "Not Active"
                            status.TextColor3 = Color3.fromRGB(255, 80, 90)
                            lastKSStatus = "Not Active"
                        end
                    else
                        status.Text = "Waiting..."
                        status.TextColor3 = Color3.fromRGB(150, 150, 165)
                        lastKSStatus = "Waiting..."
                    end
                end

                if PerksInfoEnabled then
                    local container = main.PerksContainer
                    for _, child in ipairs(container:GetChildren()) do
                        if child:IsA("TextLabel") then child:Destroy() end
                    end
                    
                    if currentKiller and currentKiller.Character then
                        local hasPerk = false
                        for _, child in ipairs(currentKiller.Character:GetChildren()) do
                            if child:IsA("Script") then
                                local cleanName = string.gsub(child.Name, "%s*%d+$", "")
                                local lowerCleanName = string.lower(cleanName)
                                
                                if ValidPerks[lowerCleanName] then
                                    hasPerk = true
                                    local pLabel = Instance.new("TextLabel")
                                    pLabel.Size = UDim2.new(1, 0, 0, 14)
                                    pLabel.BackgroundTransparency = 1
                                    pLabel.Text = cleanName
                                    pLabel.Font = Enum.Font.GothamMedium
                                    pLabel.TextSize = 12
                                    pLabel.TextColor3 = Color3.fromRGB(240, 240, 245)
                                    pLabel.TextXAlignment = Enum.TextXAlignment.Left
                                    pLabel.Parent = container
                                end
                            end
                        end
                        
                        if not hasPerk then
                            local pLabel = Instance.new("TextLabel")
