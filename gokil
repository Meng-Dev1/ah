                rowRefs[key] = {dot=dot, lbl=lbl}
                row.MouseButton1Click:Connect(function() selectedKey=key; refreshRows() end)
            end
            refreshRows()

            local divY = 30 + #buttonKeys*ITEM_H + 6
            local div = Instance.new("Frame", frame)
            div.Size = UDim2.new(1,-12,0,1); div.Position = UDim2.new(0,6,0,divY)
            div.BackgroundColor3 = Color3.fromRGB(35,35,45); div.BorderSizePixel = 0

