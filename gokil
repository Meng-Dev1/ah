function validateKeyAgainst(serviceName, key)
    local ok3, result = pcall(function()
        return Junkie.check_key(serviceName, key)
    end)

    if not ok3 or not result then return false, "server_error", nil end

    if result.valid == true and (result.message == "KEY_VALID" or result.message == "KEYLESS") then
        return true, "ok", result
    end

    local msg = result.message or result.error or "UNKNOWN"

    if msg == "HWID_BANNED" or msg == "BANNED" then return false, "banned", result
    elseif msg == "HWID_MISMATCH" then return false, "hwid_mismatch", result
    elseif msg == "KEY_EXPIRED" then return false, "expired", result
    elseif msg == "KEY_INVALID" or msg == "KEY_INVALIDATED" or msg == "ALREADY_USED" then return false, "invalid", result
    elseif msg == "SERVICE_MISMATCH" or msg == "PREMIUM_REQUIRED" then return false, "wrong_service", result
    end

    return false, "invalid", result
end

function validateKey(key)
    if not key or key == "" then return false, "empty", false end

    pcall(function()
        httpRequest({
            Method = "POST",
            Url = JUNKIE_BASE .. "/verifyOpen",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                key = "DUMMY_" .. tostring(math.random(1,9999)),
                service = PREMIUM_SERVICE,
                identifier = tostring(Junkie.identifier)
            })
        })
    end)

    local validP, reasonP = validateKeyAgainst(PREMIUM_SERVICE, key)
    if validP then return true, "ok", true end
    if reasonP == "banned" or reasonP == "expired" or reasonP == "hwid_mismatch" then
        return false, reasonP, false
    end

    local validF, reasonF = validateKeyAgainst(FREE_SERVICE, key)
    if validF then return true, "ok", false end
    if reasonF ~= "wrong_service" and reasonF ~= "invalid" then
        return false, reasonF, false
    end

    return false, reasonP, false
end

function getKeyDetails(keyValue)
    if not keyValue or keyValue == "" then return nil end
    local ok3, response = pcall(function()
        return httpRequest({
            Url = "https://api.jnkie.com/api/v2/keys/" .. HttpService:UrlEncode(keyValue),
            Method = "GET",
            Headers = {
                ["Authorization"] = "Bearer " .. JUNKIE_API_KEY,
                ["Content-Type"] = "application/json"
            }
        })
    end)
    if not ok3 or not response or response.StatusCode ~= 200 then return nil end
    local okD, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
    if not okD or not data or not data.key then return nil end
    return data.key
end

function isHWIDEmptyOnPanel(keyValue)
    if not JUNKIE_API_KEY or JUNKIE_API_KEY == "" then return false end
    local encodedKey = HttpService:UrlEncode(keyValue)
    local ok3, response = pcall(function()
        return httpRequest({
            Url = "https://api.jnkie.com/api/v2/keys?key=" .. encodedKey .. "&limit=50",
            Method = "GET",
            Headers = {
                ["Authorization"] = "Bearer " .. JUNKIE_API_KEY,
                ["Content-Type"] = "application/json"
            }
        })
    end)
    if not ok3 or not response or response.StatusCode ~= 200 then return false end
    local okD, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
    if not okD or not data or not data.keys then return false end
    for _, k in ipairs(data.keys) do
        if k.key_value == keyValue then
            local hwids = k.keys_hwid or {}
            return #hwids == 0
        end
    end
    return false
end

