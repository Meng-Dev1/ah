local function getSurvivorFrames()
    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer.PlayerGui
    local survivorFrames = {}

    local function searchInGui(guiParent)
        if not guiParent then return {} end
        
        local frames = {}
        for i = 1, 5 do
            local found = guiParent:FindFirstChild("Survivor" .. i, true)
            if found and (found:IsA("Frame") or found:IsA("ImageButton") or found:IsA("TextButton")) then
                if not table.find(frames, found) then
                    table.insert(frames, found)
                end
            end
        end
        return frames
    end

    survivorFrames = searchInGui(pGui)
    
    if #survivorFrames == 0 then
        local selectedKillerName = LocalPlayer:GetAttribute("SelectedKiller")
        local survivorGui = pGui:FindFirstChild("Survivor") or pGui:FindFirstChild("Survivor-mob") or pGui:FindFirstChild("Survivor-con")
        local sFrame = survivorGui and survivorGui:FindFirstChild("Frame")
        
        if sFrame then
            for i = 1, 5 do
                local sSlot = sFrame:FindFirstChild("Survivor" .. i)
                if sSlot then table.insert(survivorFrames, sSlot) end
            end
        end
    end

    return #survivorFrames > 0 and survivorFrames or nil
end

